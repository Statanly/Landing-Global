@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
   
}

<main class="main">

    <!-- PAGE TITLE -->
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1>Servicios</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="index.html">Inicio</a></li>
                    <li class="current">Servicios</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- INTRO -->
    <section class="section">
        <div class="container text-center" data-aos="fade-up">
            <p class="lead">
                Desarrollamos soluciones de inteligencia artificial diseñadas para resolver retos reales de negocio,
                mejorar la eficiencia operativa y generar ventajas competitivas sostenibles.
            </p>
        </div>
    </section>

    <!-- SERVICES GRID -->
    <section class="services section light-background">
        <div class="container">
            <div class="row gy-4">

                <!-- AI & ML -->
                <div class="col-lg-6" data-aos="fade-up">
                    <div class="service-item d-flex">
                        <i class="bi bi-cpu icon flex-shrink-0"></i>
                        <div>
                            <h4>Inteligencia Artificial & Machine Learning</h4>
                            <p>
                                Diseñamos y entrenamos modelos inteligentes que automatizan procesos,
                                detectan patrones y permiten tomar decisiones basadas en datos.
                            </p>
                            <ul>
                                <li>Modelos predictivos</li>
                                <li>Sistemas de recomendación</li>
                                <li>Automatización inteligente</li>
                                <li>Optimización de procesos</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Computer Vision -->
                <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="service-item d-flex">
                        <i class="bi bi-eye icon flex-shrink-0"></i>
                        <div>
                            <h4>Computer Vision</h4>
                            <p>
                                Analizamos imágenes y video en tiempo real para mejorar el control,
                                la seguridad y la eficiencia operativa.
                            </p>
                            <ul>
                                <li>Control de calidad automatizado</li>
                                <li>Reconocimiento de objetos y personas</li>
                                <li>Inspección visual industrial</li>
                                <li>Video analytics</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Data Analytics -->
                <div class="col-lg-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="service-item d-flex">
                        <i class="bi bi-bar-chart icon flex-shrink-0"></i>
                        <div>
                            <h4>Data Analytics & Big Data</h4>
                            <p>
                                Convertimos grandes volúmenes de datos en información clara,
                                útil y accionable para la toma de decisiones estratégicas.
                            </p>
                            <ul>
                                <li>Análisis avanzado de datos</li>
                                <li>Dashboards y visualización</li>
                                <li>Big Data y pipelines de datos</li>
                                <li>Business Intelligence</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Custom Solutions -->
                <div class="col-lg-6" data-aos="fade-up" data-aos-delay="300">
                    <div class="service-item d-flex">
                        <i class="bi bi-gear icon flex-shrink-0"></i>
                        <div>
                            <h4>Soluciones a medida</h4>
                            <p>
                                Cada negocio es único. Diseñamos e implementamos soluciones tecnológicas
                                adaptadas a tus necesidades, infraestructura y objetivos.
                            </p>
                            <ul>
                                <li>Arquitecturas personalizadas</li>
                                <li>Integración con sistemas existentes</li>
                                <li>Escalabilidad y seguridad</li>
                                <li>Soporte y mejora continua</li>
                            </ul>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="section dark-background text-center">
        <div class="container" data-aos="fade-up">
            <h2>¿Buscas una solución de IA adaptada a tu negocio?</h2>
            <p>
                Nuestro equipo te ayudará a definir la mejor estrategia tecnológica
                para alcanzar tus objetivos.
            </p>
            <a href="contact.html" class="btn-get-started mt-3">
                Hablar con un experto
            </a>
        </div>
    </section>

</main>