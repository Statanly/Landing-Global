@{
    Layout = "/Views/Shared/_SolutionsLayout.cshtml";
}
<main id="main">

    <!-- ======= Breadcrumbs ======= -->
    <section id="breadcrumbs" class="breadcrumbs">
        <div class="container">

            <ol>
                <li><a href="/#smart">Главная</a></li>
                <li>Правоохранительная деятельность</li>
            </ol>
        </div>
    </section><!-- End Breadcrumbs -->
    <!-- ======= Blog Single Section ======= -->
    <section id="blog" class="blog">
        <div class="container">
            <div class="section-title">
                <h2>Правоохранительная деятельность</h2>
                <p>
                    Интеллектуальная система мониторинга нарушений
                </p>
            </div>
            <div class="row">
                <div class="col-lg-4 entries">
                    <article class="entry entry-single" style="height: 450px">
                        <div class="entry-img">
                            <img src="~/assets/img/Smart city/Law enforcement/1.gif" alt="" class="img-fluid">
                        </div>
                        <h2 class="entry-title">
                            Распознавание номерных знаков
                        </h2>
                        <div class="entry-content">
                            <p>
                                Система распознавания номерных знаков и поиск автомобиля
                            </p>
                        </div>
                    </article>
                </div>
                <div class="col-lg-4 entries">
                    <article class="entry entry-single" style="height: 450px">
                        <div class="entry-img">
                            <img src="~/assets/img/Smart city/Law enforcement/2.gif" alt="" class="img-fluid">
                        </div>
                        <h2 class="entry-title">
                            Распознавание лиц
                        </h2>
                        <div class="entry-content">
                            <p>
                                Система распознавания лиц и поиска
                            </p>
                        </div>
                    </article>
                </div>
                <div class="col-lg-4 entries">
                    <article class="entry entry-single" style="height: 450px">
                        <div class="entry-img">
                            <img src="~/assets/img/Smart city/Law enforcement/3.gif" alt="" class="img-fluid">
                        </div>
                        <h2 class="entry-title">
                            Поиск по силуэтам
                        </h2>
                        <div class="entry-content">
                            <p>
                                Поиск силуэта, определение позы
                            </p>
                        </div>
                    </article>
                </div>
            </div>
        </div>
    </section>
</main><!-- End #main -->
