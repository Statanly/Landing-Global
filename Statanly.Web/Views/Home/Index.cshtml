    <!-- ======= Contact Section ======= -->
    <section id="contact" class="contact">
        <div class="container">

            <div class="section-title">
                <h2>@Localizer["Contacts"]</h2>
                <h4>@Localizer["ContactsText"]</h4>
            </div>

            <div class="row mt-1 d-flex justify-content-end">
                <div class="col-lg-5">
                    <div class="info">
                        <div class="address">
                            <i class="bi bi-geo-alt"></i>
                            <h4>@Localizer["Address"]:</h4>
                            <p>@Localizer["AddressText"]</p>
                        </div>
                        <div class="email">
                            <a href="mailto:hello@statanly.com" target="_blank"><i class="bi bi-envelope"></i></a>
                            <h4>@Localizer["Email"]:</h4>
                            <p><a href="mailto:hello@statanly.com" target="_blank">hello@statanly.com</a></p>
                        </div>
                        <div class="phone">
                            <a href="tel:+7 (921)-875-23-96" target="_blank"><i class="bi bi-phone"></i></a>
                            <h4>@Localizer["Phone"]:</h4>
                            <p><a href="tel:+7 (921)-875-23-96" target="_blank">+7(921)8752396</a></p>
                        </div>
                        <div class="telegram">
                            <a href="https://t.me/statanly" target="_blank"><i class="bi bi-telegram"></i></a>
                            <h4>Telegram:</h4>
                            <p><a href="https://t.me/statanly" target="_blank">Telegram</a></p>
                        </div>
                        <div class="whatsapp">
                            <a href="https://wa.me/79218752396" target="_blank"><i class="bi bi-whatsapp"></i></a>
                            <h4>Whatsapp:</h4>
                            <p><a href="https://wa.me/79218752396" target="_blank">WhatsApp</a></p>
                        </div>
                    </div>

                </div>

                <div class="col-lg-6 mt-5 mt-lg-0">
                    <form action="/message/send" method="post" role="form" class="php-email-form">
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <input type="text" name="name" class="form-control" id="name" placeholder=@Localizer["Name"] required>
                            </div>
                            <div class="col-md-6 form-group mt-3 mt-md-0">
                                <input type="email" class="form-control" name="email" id="email" placeholder=@Localizer["Email"] required>
                            </div>
                        </div>
                        @*<div class="form-group mt-3">
                            <input type="text" class="form-control" name="subject" id="subject" placeholder=@Localizer["Subject"] required>
                        </div>*@
                        <div class="form-group mt-3">
                            <textarea class="form-control" name="text" rows="5" placeholder=@Localizer["Message"] required></textarea>
                        </div>
                        <div class="my-3">
                            <div class="loading">@Localizer["Sending"]</div>
                            <div class="error-message">@Localizer["Error"]</div>
                            <div class="sent-message">@Localizer["SendMessage"]</div>
                        </div>
                        <div class="form-group mt-3">
                            <input type="text" class="form-control" name="check" id="subject" placeholder="2 + 5 =" required>
                        </div>
                        <div class="text-center"><button type="submit">@Localizer["Send"]</button></div>
                    </form>
                </div>

            </div>

        </div>
    </section><!-- End Contact Section -->

