
<style>
     .about-platform-note {
         display: flex;
         align-items: flex-start;
         gap: 18px;
         padding: 24px 28px;
         border: 1px solid #e7edf5;
         border-left: 4px solid #ef233c;
         border-radius: 16px;
         background: #ffffff;
         box-shadow: 0 10px 30px rgba(16, 54, 92, 0.05);
     }

         .about-platform-note i {
             font-size: 24px;
             line-height: 1;
             color: #ef233c;
             flex: 0 0 auto;
             margin-top: 2px;
         }

         .about-platform-note strong {
             font-size: 18px;
             line-height: 1.55;
             font-weight: 700;
             color: #0b1f33;
         }

     /*Video*/
     .demo-video {
         padding: 50px 0;
         background: #ffffff;
     }

     .demo-video-card {
         display: grid;
         grid-template-columns: 1fr 420px;
         gap: 36px;
         align-items: center;
         padding: 34px;
         border-radius: 24px;
         background: linear-gradient(135deg, #071322 0%, #0b1f33 100%);
         box-shadow: 0 20px 50px rgba(11, 31, 51, 0.16);
         overflow: hidden;
     }

     .demo-video-kicker {
         display: inline-block;
         margin-bottom: 12px;
         color: #ef233c;
         font-weight: 700;
         letter-spacing: 0.04em;
         text-transform: uppercase;
         font-size: 13px;
     }

     .demo-video-content h3 {
         margin: 0 0 14px;
         color: #ffffff;
         font-size: 34px;
         font-weight: 800;
     }

     .demo-video-content p {
         margin: 0 0 24px;
         color: rgba(255, 255, 255, 0.78);
         font-size: 17px;
         line-height: 1.6;
         max-width: 680px;
     }

     .demo-video-btn {
         display: inline-flex;
         align-items: center;
         gap: 10px;
         border: 0;
         border-radius: 999px;
         padding: 13px 22px;
         background: #ef233c;
         color: #ffffff;
         font-weight: 700;
         transition: 0.2s ease;
     }

         .demo-video-btn:hover {
             transform: translateY(-1px);
             background: #d91f36;
         }

         .demo-video-btn i {
             font-size: 20px;
         }

     .demo-video-preview {
         position: relative;
         display: block;
         width: 100%;
         border: 0;
         padding: 0;
         border-radius: 20px;
         overflow: hidden;
         background: #000;
         box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
         cursor: pointer;
     }

         .demo-video-preview img {
             width: 100%;
             display: block;
             aspect-ratio: 16 / 9;
             object-fit: cover;
             opacity: 0.86;
         }

     .demo-video-play {
         position: absolute;
         inset: 0;
         margin: auto;
         width: 74px;
         height: 74px;
         border-radius: 50%;
         background: rgba(239, 35, 60, 0.94);
         color: #ffffff;
         display: flex;
         align-items: center;
         justify-content: center;
         font-size: 34px;
         box-shadow: 0 12px 30px rgba(239, 35, 60, 0.35);
     }

     .demo-video-modal {
         background: #071322;
         border: 0;
         border-radius: 18px;
         overflow: hidden;
     }

         .demo-video-modal .modal-header {
             border-bottom: 1px solid rgba(255, 255, 255, 0.12);
             color: #ffffff;
         }

         .demo-video-modal .modal-body {
             padding: 0;
         }

     @@media (max-width: 991px) {
         .demo-video-card {
             grid-template-columns: 1fr;
             padding: 26px;
         }

         .demo-video-content h3 {
             font-size: 28px;
         }
     }
     /* ==============================================================
    HOME HERO — Event Analytics Factory
    Strict fullscreen style: dark, clean, no cards, no neon clutter
    ============================================================== */

     #hero.hero-eaf {
         position: relative;
         isolation: isolate;
         min-height: calc(100vh - 76px);
         padding: 0 !important;
         overflow: hidden;
         display: flex;
         align-items: center;
         color: #fff;
         background: #030b17;
         font-family: var(--default-font);
     }

         #hero.hero-eaf .hero-eaf-bg {
             position: absolute;
             inset: 0;
             z-index: -3;
             background-image: url('/assets/img/hero/event-analytics-hero-bg.png');
             background-size: cover;
             background-position: center center;
             background-repeat: no-repeat;
             transform: scale(1.01);
         }

         /* Dark readability layer, keeps background strict and text readable */
         #hero.hero-eaf::before {
             content: "";
             position: absolute;
             inset: 0;
             z-index: -2;
             pointer-events: none;
             background: linear-gradient(90deg, rgba(3, 8, 18, 0.92) 0%, rgba(3, 8, 18, 0.72) 42%, rgba(3, 8, 18, 0.42) 72%, rgba(3, 8, 18, 0.56) 100%), linear-gradient(180deg, rgba(3, 8, 18, 0.28) 0%, rgba(3, 8, 18, 0.08) 48%, rgba(3, 8, 18, 0.54) 100%);
         }

         /* Corporate red accent, very restrained */
         #hero.hero-eaf::after {
             content: "";
             position: absolute;
             left: -18%;
             bottom: -30%;
             width: 58%;
             height: 58%;
             z-index: -1;
             pointer-events: none;
             background: radial-gradient(circle, rgba(239, 35, 60, 0.30) 0%, rgba(239, 35, 60, 0.13) 30%, transparent 68%);
             filter: blur(10px);
         }

         #hero.hero-eaf .hero-eaf-container {
             position: relative;
             z-index: 2;
             width: 100%;
         }

         #hero.hero-eaf .hero-eaf-content {
             max-width: 1040px;
             padding-top: 58px;
             padding-bottom: 58px;
         }

         #hero.hero-eaf .hero-eaf-kicker {
             display: inline-flex;
             align-items: center;
             gap: 20px;
             margin-bottom: 30px;
         }

             #hero.hero-eaf .hero-eaf-kicker span {
                 width: 64px;
                 height: 3px;
                 border-radius: 999px;
                 background: #ef233c;
                 box-shadow: 0 0 18px rgba(239, 35, 60, 0.28);
             }

             #hero.hero-eaf .hero-eaf-kicker p {
                 margin: 0;
                 font-family: var(--nav-font);
                 font-size: 14px;
                 line-height: 1.2;
                 font-weight: 600;
                 letter-spacing: 0.12em;
                 text-transform: uppercase;
                 color: rgba(255, 255, 255, 0.86);
             }

         #hero.hero-eaf h1 {
             margin: 0 0 26px;
             max-width: 1120px;
             color: #ffffff;
             font-family: var(--heading-font);
             font-size: clamp(58px, 7vw, 108px);
             font-weight: 800;
             line-height: 0.98;
             letter-spacing: -0.045em;
             text-transform: none;
             text-shadow: 0 18px 45px rgba(0, 0, 0, 0.32);
         }

         #hero.hero-eaf .hero-eaf-motto {
             margin: 0 0 22px;
             max-width: 980px;
             color: rgba(255, 255, 255, 0.94);
             font-family: var(--heading-font);
             font-size: clamp(27px, 3.1vw, 46px);
             line-height: 1.18;
             font-weight: 500;
             letter-spacing: -0.018em;
         }

         #hero.hero-eaf .hero-eaf-lead {
             margin: 0;
             max-width: 720px;
             color: rgba(255, 255, 255, 0.82);
             font-family: var(--default-font);
             font-size: clamp(18px, 1.25vw, 22px);
             line-height: 1.58;
             font-weight: 400;
         }

     /* Desktop alignment: close to VizorLabs reference but cleaner */
     @@media (min-width: 1200px) {
         #hero.hero-eaf .hero-eaf-content {
             margin-left: 2vw;
         }
     }

     /* Tablet */
     @@media (max-width: 991px) {
         #hero.hero-eaf {
             min-height: calc(100vh - 66px);
         }

             #hero.hero-eaf .hero-eaf-bg {
                 background-position: 62% center;
             }

             #hero.hero-eaf::before {
                 background: linear-gradient(90deg, rgba(3, 8, 18, 0.94) 0%, rgba(3, 8, 18, 0.78) 58%, rgba(3, 8, 18, 0.62) 100%), linear-gradient(180deg, rgba(3, 8, 18, 0.18) 0%, rgba(3, 8, 18, 0.58) 100%);
             }

             #hero.hero-eaf .hero-eaf-content {
                 padding-top: 72px;
                 padding-bottom: 72px;
             }

             #hero.hero-eaf h1 {
                 font-size: clamp(48px, 10vw, 76px);
                 letter-spacing: -0.035em;
             }
     }

     /* Mobile */
     @@media (max-width: 575px) {
         #hero.hero-eaf {
             min-height: calc(100vh - 62px);
             align-items: flex-start;
         }

             #hero.hero-eaf .hero-eaf-bg {
                 background-position: 66% center;
                 opacity: 0.96;
             }

             #hero.hero-eaf::before {
                 background: linear-gradient(90deg, rgba(3, 8, 18, 0.96) 0%, rgba(3, 8, 18, 0.86) 100%), linear-gradient(180deg, rgba(3, 8, 18, 0.20) 0%, rgba(3, 8, 18, 0.66) 100%);
             }

             #hero.hero-eaf .hero-eaf-content {
                 padding-top: 96px;
                 padding-bottom: 64px;
             }

             #hero.hero-eaf .hero-eaf-kicker {
                 gap: 14px;
                 margin-bottom: 24px;
             }

                 #hero.hero-eaf .hero-eaf-kicker span {
                     width: 42px;
                     height: 2px;
                 }

                 #hero.hero-eaf .hero-eaf-kicker p {
                     font-size: 11px;
                     letter-spacing: 0.10em;
                 }

             #hero.hero-eaf h1 {
                 margin-bottom: 24px;
                 font-size: clamp(42px, 13vw, 58px);
                 line-height: 1.02;
                 letter-spacing: -0.03em;
             }

             #hero.hero-eaf .hero-eaf-motto {
                 margin-bottom: 18px;
                 font-size: clamp(25px, 7.4vw, 34px);
                 line-height: 1.22;
             }

             #hero.hero-eaf .hero-eaf-lead {
                 font-size: 17px;
                 line-height: 1.55;
             }
     }
</style>
