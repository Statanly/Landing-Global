/* ==============================================================
   HOME HERO — Event Analytics Factory
   Clean final CSS for exact HTML structure
   ============================================================== */

#hero.factory-hero-static {
    position: relative;
    isolation: isolate;
    padding: 0 !important;
    overflow: hidden;
    min-height: calc(100vh - 76px);
    color: #ffffff;
    background:
        radial-gradient(circle at 18% 44%, rgba(0, 82, 165, 0.30) 0%, rgba(0, 82, 165, 0.08) 34%, transparent 62%),
        radial-gradient(circle at 76% 36%, rgba(0, 145, 255, 0.12) 0%, transparent 44%),
        linear-gradient(135deg, #020713 0%, #03152b 47%, #020b1c 100%) !important;
}

#hero.factory-hero-static::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background: linear-gradient(
        90deg,
        rgba(2, 7, 19, 0.97) 0%,
        rgba(3, 16, 35, 0.90) 42%,
        rgba(3, 16, 35, 0.68) 100%
    );
}

#hero.factory-hero-static::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 34%;
    z-index: -1;
    pointer-events: none;
    opacity: 0.55;
    background-image:
        radial-gradient(circle, rgba(0, 149, 255, 0.48) 1px, transparent 1.8px),
        linear-gradient(90deg, rgba(0, 149, 255, 0.11) 1px, transparent 1px),
        linear-gradient(0deg, rgba(0, 149, 255, 0.09) 1px, transparent 1px);
    background-size: 30px 30px, 70px 70px, 70px 70px;
    transform: perspective(820px) rotateX(64deg) translateY(34%);
    transform-origin: bottom center;
}

#hero.factory-hero-static .factory-hero-bg {
    position: absolute;
    inset: 0;
    z-index: -3;
}

/* Main container */
#hero.factory-hero-static .factory-hero-shell {
    position: relative;
    z-index: 2;
    min-height: calc(100vh - 76px);
    max-width: 1320px;
    margin: 0 auto;
    padding-top: clamp(30px, 3.4vw, 54px);
    padding-bottom: clamp(30px, 3.2vw, 50px);
    display: flex;
    align-items: center;
}

/* Left ≈ 1/3, right ≈ 2/3 */
#hero.factory-hero-static .factory-hero-grid {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(360px, 0.82fr) minmax(760px, 1.72fr);
    gap: clamp(34px, 3.6vw, 58px);
    align-items: stretch;
}

/* ==============================================================
   LEFT SIDE
   ============================================================== */

#hero.factory-hero-static .factory-hero-copy {
    min-width: 0;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding-top: 4px;
}

#hero.factory-hero-static .factory-hero-kicker {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
    font-family: var(--heading-font);
    font-size: 14px;
    font-weight: 800;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #22d3ee;
}

#hero.factory-hero-static .factory-hero-kicker-line {
    display: block;
    width: 68px;
    height: 4px;
    flex: 0 0 auto;
    border-radius: 999px;
    background: linear-gradient(90deg, #0ea5ff 0%, #22d3ee 100%);
