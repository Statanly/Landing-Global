@{
    Layout = "/Views/Shared/_SolutionsLayout.cshtml";
}
<main id="main">

    <!-- ======= Breadcrumbs ======= -->
    <section id="breadcrumbs" class="breadcrumbs">
        <div class="container">
            <h2>Приложения системы</h2>
            <ol>
                <li><a href="/#solutions">Главная</a></li>
                <li>Проекты</li>
            </ol>
        </div>
    </section><!-- End Breadcrumbs -->
    <!-- ======= Portfolio Details Section ======= -->
    <section id="portfolio-details" class="portfolio-details">
        <div class="container">

            <div class="row gy-4">



                <div class="col-lg-12">
                    <div class="portfolio-info">
                        <h3>Иерархическая система классификации веб-сайтов (по категориям)</h3>
                        <ul>
                            <li><strong>Категория</strong>: NLP</li>
                            <li><strong>Клиент</strong>: Segmento</li>
                            <li><strong>Project date</strong>: 2022</li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </section><!-- End Portfolio Details Section -->
    <!-- ======= About Section ======= -->
    <section id="about" class="about">
        <div class="container">

            <div class="row">
                <div class="col-lg-12 pt-4 pt-lg-0">
                    <p>
                        Система относит веб-сайт к одной или нескольким из более чем 500 категорий и используется для маркетинговых и рекламных кампаний.
                    </p>
                    <p>
                        <strong>Подходы</strong>
                    </p>
                    <ul>
                        <li>
                            <i class="bx bx-check-double"></i> Tf-Idf + NodesLocalClassifier
                        </li>
                        <li>
                            <i class="bx bx-check-double"></i> ByteLevelBPE + HMCN
                        </li>
                        <li>
                            <i class="bx bx-check-double"></i> Word-piece + RuBert
                        </li>
                    </ul>
                    <p>
                        <strong>Специфические особенности данных</strong>
                    </p>
                    <ul>
                        <li>
                            <i class="bx bx-check-double"></i> Недоступные веб страницы
                        </li>
                        <li>
                            <i class="bx bx-check-double"></i> Неправильные метки
                        </li>
                        <li>
                            <i class="bx bx-check-double"></i> Дисбаланс классов
                        </li>
                    </ul>
                    <p>
                        <strong>Оценка моделей</strong>
                    </p>
                    <p>
                        Метрики оценки качества моделей:
                    </p>
                    <ul>
                        <li>
                            <i class="bx bx-check-double"></i> h-fbeta (MSE)
                        </li>
                        <li>
                            <i class="bx bx-check-double"></i> h-precision
                        </li>
                        <li>
                            <i class="bx bx-check-double"></i> h-recall
                        </li>
                    </ul>
                    <p style="text-align:center"><em>Метрики</em></p>
                    </br>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <th>

                                </th>
                                <th>
                                    HMCN
                                </th>
                                <th>
                                    NLC
                                </th>
                                <th>
                                    RuBert
                                </th>
                            </tr>
                            <tr>
                                <td>H-fbeta</td>
                                <td> <strong>0.53</strong></td>
                                <td> 0.39</td>
                                <td> 0.2</td>
                            </tr>
                            <tr>
                                <td>H-precision</td>
                                <td> 0.87</td>
                                <td> 0.48</td>
                                <td> <strong>0.93</strong></td>
                            </tr>
                            <tr>
                                <td>H-recall</td>
                                <td> 0.38</td>
                                <td> 0.33</td>
                                <td> 0.11</td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </section><!-- End About Section -->
</main><!-- End #main -->