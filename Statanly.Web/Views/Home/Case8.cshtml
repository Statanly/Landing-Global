@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options

@inject IViewLocalizer Localizer
@inject IOptions<RequestLocalizationOptions> LocOptions

@{
    // получаем сервис IRequestCultureFeature
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    // получаем список поддерживаемых культур
    var cultureItems = LocOptions.Value.SupportedUICultures
        .Select(c => new SelectListItem { Value = c.Name, Text = c.Name.ToUpper() })
        .ToList();
    var lang = requestCulture.RequestCulture.UICulture.Name.ToUpper();
}
<!-- ======= Header ======= -->
<header id="header" class="fixed-top d-flex align-items-center header-inner-pages">
    <div class="container d-flex align-items-center justify-content-between">
        <a href="/"><img class="logo" style="height: 43px; width: 160px" src="~/assets/img/logo.png"></a>
        @*<h1 class="logo"><a href="index.html">Anyar</a></h1>*@
        <!-- Uncomment below if you prefer to use an image logo -->
        <!-- <a href=index.html" class="logo"><img src="assets/img/logo.png" alt="" class="img-fluid"></a>-->

        <nav id="navbar" class="navbar">
            <ul>
                <li><a class="nav-link scrollto" href="/">@Localizer["Main"]</a></li>
                <li><a class="nav-link scrollto active" href="/home/solution">@Localizer["Solutions"]</a></li>
                <li><a class="nav-link scrollto" href="/home/company">@Localizer["Company"]</a></li>
                <li><a class="nav-link scrollto" href="/home/research">@Localizer["Research"]</a></li>
                <li><a class="nav-link scrollto " href="/home/contact">@Localizer["Contacts"]</a></li>
                <li class="dropdown">
                    <a href="#"><span>@lang</span> <i class="bi bi-chevron-down"></i></a>
                    <ul>
                        <li><a href="/home/setLanguage?culture=ru&returnUrl=@Context.Request.Path">Ru</a></li>
                        <li><a href="/home/setLanguage?culture=en&returnUrl=@Context.Request.Path">En</a></li>
                    </ul>
                </li>
            </ul>
            <i class="bi bi-list mobile-nav-toggle"></i>
        </nav><!-- .navbar -->

    </div>
</header><!-- End Header -->
<main id="main">

    <!-- ======= Breadcrumbs ======= -->
    <section id="breadcrumbs" class="breadcrumbs">
        <div class="container">

            <div class="d-flex justify-content-between align-items-center">
                <h2>Приложения системы</h2>
                <ol>
                    <li><a href="/#solutions">Главная</a></li>
                    <li>Проекты</li>
                </ol>
            </div>

        </div>
    </section><!-- End Breadcrumbs -->
    <!-- ======= Portfolio Details Section ======= -->
    <section id="portfolio-details" class="portfolio-details">
        <div class="container">

            <div class="row gy-4">



                <div class="col-lg-12">
                    <div class="portfolio-info">
                        <h3>Forecasting Airline Ticket Sales Conversion Rate</h3>
                        <ul>
                            <li><strong>Category</strong>: Forecasting</li>
                            <li><strong>Client</strong>: Onlive Travel Agency</li>
                            <li><strong>Project date</strong>: 2017</li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </section><!-- End Portfolio Details Section -->
    <!-- ======= About Section ======= -->
    <section id="about" class="about">
        <div class="container">

            <div class="row">
                <div class="col-lg-12 pt-4 pt-lg-0">
                    <p>
                        <strong>
                            Forecasting Airline Ticket Sales Conversion Rate
                        </strong>
                    </p>
                    <p>
                        Our system provides comprehensive historical data regarding the display of flight offers, encompassing various parameters such as time, departure and arrival airports, number of stops, layover time, ticket class, number of passengers, and more. This data, combined with information on ticket purchases, serves as the foundation for building accurate machine learning models to predict the conversion rate of airline ticket sales.
                    </p>
                    <p>
                        <strong>General task</strong>: Developing a predictive system that identifies queries with the highest conversion rate. Additionally, the forecast system can be employed to identify queries that are unlikely to result in a purchase, thereby optimizing revenue by minimizing non-converting impressions.

                    </p>
                    <p>
                        <strong>Forecasting Air Ticket Price Fluctuations</strong>
                    </p>
                    <p>
                        Building upon the sales conversion forecasting system, we address the optimization problem of determining the optimal mark-up for air ticket prices, focusing on the concept of dynamic pricing.
                    </p>
                    <p>
                        <strong>General task</strong>: Establishing a system for predicting price margins on air tickets, with the aim of maximizing sales conversion and profitability.
                    </p>
                </div>
            </div>

        </div>
    </section><!-- End About Section -->
</main><!-- End #main -->