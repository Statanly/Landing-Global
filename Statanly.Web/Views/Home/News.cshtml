@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options

@inject IViewLocalizer Localizer
@inject IOptions<RequestLocalizationOptions> LocOptions

@{
    // получаем сервис IRequestCultureFeature
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    // получаем список поддерживаемых культур
    var cultureItems = LocOptions.Value.SupportedUICultures
        .Select(c => new SelectListItem { Value = c.Name, Text = c.Name.ToUpper() })
        .ToList();
    var lang = requestCulture.RequestCulture.UICulture.Name.ToUpper();
}
<!-- ======= Header ======= -->
<header id="header" class="fixed-top d-flex align-items-center header-inner-pages">
    <div class="container d-flex align-items-center justify-content-between">
        <a href="/"><img class="logo" style="height: 43px; width: 160px" src="~/assets/img/logo.png"></a>
        @*<h1 class="logo"><a href="index.html">Anyar</a></h1>*@
        <!-- Uncomment below if you prefer to use an image logo -->
        <!-- <a href=index.html" class="logo"><img src="assets/img/logo.png" alt="" class="img-fluid"></a>-->

        <nav id="navbar" class="navbar">
            <ul>
                <li><a class="nav-link scrollto" href="/">@Localizer["Main"]</a></li>
                <li><a class="nav-link scrollto active" href="/home/solution">@Localizer["Solutions"]</a></li>
                <li><a class="nav-link scrollto" href="/home/company">@Localizer["Company"]</a></li>
                <li><a class="nav-link scrollto" href="/home/research">@Localizer["Research"]</a></li>
                <li><a class="nav-link scrollto " href="/home/contact">@Localizer["Contacts"]</a></li>
                <li class="dropdown">
                    <a href="#"><span>@lang</span> <i class="bi bi-chevron-down"></i></a>
                    <ul>
                        <li><a href="/home/setLanguage?culture=ru&returnUrl=@Context.Request.Path">Ru</a></li>
                        <li><a href="/home/setLanguage?culture=en&returnUrl=@Context.Request.Path">En</a></li>
                    </ul>
                </li>
            </ul>
            <i class="bi bi-list mobile-nav-toggle"></i>
        </nav><!-- .navbar -->

    </div>
</header><!-- End Header -->
<main id="main">
    <!-- ======= Breadcrumbs ======= -->
    <section id="breadcrumbs" class="breadcrumbs">
        <div class="container">

            <ol>
                <li><a href="/home/solution">@Localizer["Solutions"]</a></li>
                <li><a href="/home/services">@Localizer["Services"]</a></li>
                <li><a href="/home/smartcity">@Localizer["SmartCity"]</a></li>
            </ol>
            <h2>Последние новости</h2>
        </div>
    </section><!-- End Breadcrumbs -->
    <section id="blog" class="blog">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="sidebar">              
                      <div class="sidebar-item recent-posts">
