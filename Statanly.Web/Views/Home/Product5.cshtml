                        </p>
                        <ul>
                            <li>
                                Номерные знаки
                            </li>
                            <li>
                                Тип ТС: (0: 'BIG_BUS'
                                1: 'BIG_TRUCK' ('CISTERNS', 'CONCRETE_MIXERS', 'CRANES');
                                2: 'MIDDLE_BUS'
                                3: 'MIDDLE_TRUCK' ('TOW_TRUCK', 'GAZELLE')
                                4: 'MINI_TRUCK'
                                5: 'VAN' ('LIMOUSINE')
                                6: 'CAR'('JEEP')
                                7: Ciclist (Мотоциклисты, велосипедисты, самокаты))
                            </li>
                            <li>
                                Цвет
                            </li>
                            <li>
                                Марка/модель
                            </li>
                            <li>
                                Скорость
                            </li>
                            <li>
                                Нарушение ПДД
                            </li>
