                    <li><a href="/industry/transport">Транспорт</a></li>
                    <li><a href="/industry/media">Медиа, реклама</a></li>
                    <li><a href="/industry/insurance">Страхование</a></li>
                    <li><a href="/home/smartcity">Умный город</a></li>
                </ul>
            </li>
            <li class="dropdown">
                <a href="/home/company"><span>@Localizer["Company"]</span> <i class="bi bi-chevron-down"></i></a>
                <ul>
                    <li><a href="/home/company">@Localizer["History"]</a></li>
                    <li><a href="/home/team">@Localizer["Team"]</a></li>
                    <li><a href="/home/mission">@Localizer["Mission"]</a></li>
                    <li><a href="/home/press">@Localizer["Press"]</a></li>
