@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options

@inject IViewLocalizer Localizer
@inject IOptions<RequestLocalizationOptions> LocOptions

@{
    // получаем сервис IRequestCultureFeature
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    // получаем список поддерживаемых культур
    var cultureItems = LocOptions.Value.SupportedUICultures
        .Select(c => new SelectListItem { Value = c.Name, Text = c.Name.ToUpper() })
        .ToList();
    var lang = requestCulture.RequestCulture.UICulture.Name.ToUpper();
}

<!-- ======= Header ======= -->
<header id="header" class="fixed-top d-flex align-items-center header-inner-pages">
    <div class="container d-flex align-items-center justify-content-between">
        <a href="/"><img class="logo" style="height: 43px; width: 160px" src="~/assets/img/logo.png"></a>
        @*<h1 class="logo"><a href="index.html">Anyar</a></h1>*@
        <!-- Uncomment below if you prefer to use an image logo -->
        <!-- <a href=index.html" class="logo"><img src="assets/img/logo.png" alt="" class="img-fluid"></a>-->

        <nav id="navbar" class="navbar">
            <ul>
                <li><a class="nav-link scrollto" href="/">@Localizer["Main"]</a></li>
                <li><a class="nav-link scrollto" href="/home/solution">@Localizer["Solutions"]</a></li>
                <li><a class="nav-link scrollto" href="/home/company">@Localizer["Company"]</a></li>
                <li><a class="nav-link scrollto" href="/home/research">@Localizer["Research"]</a></li>
                <li><a class="nav-link scrollto active" href="/home/contact">@Localizer["Contacts"]</a></li>
                <li class="dropdown">
                    <a href="#"><span>@lang</span> <i class="bi bi-chevron-down"></i></a>
                    <ul>
                        <li><a href="/home/setLanguage?culture=ru&returnUrl=@Context.Request.Path">Ru</a></li>
                        <li><a href="/home/setLanguage?culture=en&returnUrl=@Context.Request.Path">En</a></li>
                    </ul>
                </li>
            </ul>
            <i class="bi bi-list mobile-nav-toggle"></i>
        </nav><!-- .navbar -->

    </div>
</header><!-- End Header -->

<main id="main">

    <!-- ======= Breadcrumbs ======= -->
    <section id="breadcrumbs" class="breadcrumbs">
        <div class="container">

            <ol>
                <li><a href="/home/company">@Localizer["History"]</a></li>
                <li><a href="/home/team">@Localizer["Team"]</a></li>
                <li><a href="/home/mission">@Localizer["Mission"]</a></li>
                <li><a href="/home/press">@Localizer["Press"]</a></li>
                <li><a href="/home/cooperation">@Localizer["Cooperation"]</a></li>
                <li>@Localizer["Contacts"]</li>
            </ol>
            <h2>@Localizer["Contacts"]</h2>
        </div>
    </section><!-- End Breadcrumbs -->
    <section id="contact" class="contact">
        <div class="container" data-aos="fade-up">

            <div class="section-title">
                <h2>@Localizer["Questions"]</h2>
                <h4>@Localizer["WriteToUs"]</h4>
            </div>

            <div class="row mt-1 d-flex justify-content-end" data-aos="fade-right" data-aos-delay="100">
                <div class="col-lg-5">
                    <div class="info">
                        <div class="address">
                            <i class="bi bi-geo-alt"></i>
                            <h4>@Localizer["Address"]:</h4>
                            <p>@Localizer["AddressText"]</p>
                        </div>
                        <div class="email">
                            <a href="mailto:hello@statanly.com" target="_blank"><i class="bi bi-envelope"></i></a>
                            <h4>@Localizer["Email"]:</h4>
                            <p><a href="mailto:hello@statanly.com" target="_blank">hello@statanly.com</a></p>
                        </div>
                        <div class="phone">
                            <a href="tel:+7 (921)-875-23-96" target="_blank"><i class="bi bi-phone"></i></a>
                            <h4>@Localizer["Phone"]:</h4>
                            <p><a href="tel:+7 (921)-875-23-96" target="_blank">+7(921)8752396</a></p>
                        </div>
                        <div class="telegram">
                            <a href="https://t.me/statanly" target="_blank"><i class="bi bi-telegram"></i></a>
                            <h4>Telegram:</h4>
                            <p><a href="https://t.me/statanly" target="_blank">Telegram</a></p>
                        </div>
                        <div class="whatsapp">
                            <a href="https://wa.me/79218752396" target="_blank"><i class="bi bi-whatsapp"></i></a>
                            <h4>Whatsapp:</h4>
                            <p><a href="https://wa.me/79218752396" target="_blank">WhatsApp</a></p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 mt-5 mt-lg-0" data-aos="fade-left" data-aos-delay="100">
                    <form action="/message/send" method="post" role="form" class="php-email-form">
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <input type="text" name="name" class="form-control" id="name" placeholder=@Localizer["Name"] required>
                            </div>
                            <div class="col-md-6 form-group mt-3 mt-md-0">
                                <input type="email" class="form-control" name="email" id="email" placeholder=@Localizer["Email"] required>
                            </div>
                        </div>
                        @*<div class="form-group mt-3">
                            <input type="text" class="form-control" name="subject" id="subject" placeholder=@Localizer["Subject"] required>
                        </div>*@
                        <div class="form-group mt-3">
                            <textarea class="form-control" name="text" rows="5" placeholder=@Localizer["Message"] required></textarea>
                        </div>
                        <div class="my-3">
                            <div class="loading">@Localizer["Sending"]</div>
                            <div class="error-message">@Localizer["Error"]</div>
                            <div class="sent-message">@Localizer["SendMessage"]</div>
                        </div>
                        <div class="form-group mt-3">
                            <input type="text" class="form-control" name="check" id="subject" placeholder="2 + 5 =" required>
                        </div>
                        <div class="text-center">
                            <button type="submit">@Localizer["Send"]</button>
                        </div>
                    </form>
                </div>

            </div>

        </div>
    </section><!-- End Contact Section -->

</main><!-- End #main -->
