                <a href="/home/solution"><span>@Localizer["Solutions"]</span> <i class="bi bi-chevron-down"></i></a>
                <ul>
                    <li><a href="/home/solution">@Localizer["Projects"]</a></li>
                    <li><a href="/home/services">@Localizer["Services"]</a></li>
                    <li><a href="/home/products">@Localizer["Products"]</a></li>
