@{
    ViewData["Title"] = "Privacy Policy";
}

<header id="header" class="header d-flex align-items-center sticky-top">
    <div class="container-fluid container-xl position-relative d-flex align-items-center">

        <a href="/" class="logo d-flex align-items-center me-auto">
            <img src="~/favicon.png" alt="STATANLY Tech Global">
            <h1 class="sitename">STATANLY</h1>
        </a>

        <nav id="navmenu" class="navmenu">
            <ul>
                <li><a data-i18n="nav.home" href="/">Home</a></li>
                <li><a data-i18n="nav.platform" href="/home/platform">Platform</a></li>
                <li><a data-i18n="nav.services" href="/services">Services</a></li>
                <li><a data-i18n="nav.products" href="/products">Products</a></li>
                <li><a data-i18n="nav.contacts" href="/home/contacts">Contacts</a></li>

                <!-- Mobile language selector -->
                <li class="mobile-only mobile-lang-block">
                    <div class="mobile-lang-title" data-i18n="common.language">Language</div>

                    <div class="mobile-lang-grid">
                        <button class="mobile-lang-option lang-option" type="button" data-lang="en">
                            <span class="fi fi-gb"></span> English
                        </button>
                        <button class="mobile-lang-option lang-option" type="button" data-lang="pt">
                            <span class="fi fi-pt"></span> Português
                        </button>
                        <button class="mobile-lang-option lang-option" type="button" data-lang="es">
                            <span class="fi fi-es"></span> Español
                        </button>
                        <button class="mobile-lang-option lang-option" type="button" data-lang="it">
                            <span class="fi fi-it"></span> Italiano
                        </button>
                        <button class="mobile-lang-option lang-option" type="button" data-lang="fr">
                            <span class="fi fi-fr"></span> Français
                        </button>
                        <button class="mobile-lang-option lang-option" type="button" data-lang="de">
                            <span class="fi fi-de"></span> Deutsch
                        </button>
                        <button class="mobile-lang-option lang-option" type="button" data-lang="ru">
                            <span class="fi fi-ru"></span> Русский
                        </button>
                    </div>
                </li>

                <!-- Mobile CTA -->
                <li class="mobile-only mobile-cta-block">
                    <a class="mobile-getstarted" href="/#contact" data-i18n="common.getStarted">
                        Get Started
                    </a>
                </li>
            </ul>

            <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
        </nav>

        <!-- Desktop language selector -->
        <div class="language-flags dropdown desktop-lang">
            <button class="lang-current dropdown-toggle" type="button" id="languageDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="fi fi-gb lang-flag"></span>
                <span class="lang-code">EN</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown">
                <li><button class="dropdown-item lang-option" type="button" data-lang="en"><span class="fi fi-gb"></span> English</button></li>
                <li><button class="dropdown-item lang-option" type="button" data-lang="pt"><span class="fi fi-pt"></span> Português</button></li>
                <li><button class="dropdown-item lang-option" type="button" data-lang="es"><span class="fi fi-es"></span> Español</button></li>
                <li><button class="dropdown-item lang-option" type="button" data-lang="it"><span class="fi fi-it"></span> Italiano</button></li>
                <li><button class="dropdown-item lang-option" type="button" data-lang="fr"><span class="fi fi-fr"></span> Français</button></li>
                <li><button class="dropdown-item lang-option" type="button" data-lang="de"><span class="fi fi-de"></span> Deutsch</button></li>
                <li><button class="dropdown-item lang-option" type="button" data-lang="ru"><span class="fi fi-ru"></span> Русский</button></li>
            </ul>
        </div>

        <!-- Desktop CTA -->
        <a class="btn-getstarted desktop-cta" href="/#contact" data-i18n="common.getStarted">Get Started</a>

    </div>
</header>

<style>
    .privacy-page {
        color: #172b4d;
        background: #ffffff;
    }

    .privacy-page * {
        box-sizing: border-box;
    }

    .privacy-hero {
        padding: 8px 0 34px;
        border-bottom: 1px solid #e7edf5;
        margin-bottom: 34px;
    }

    .privacy-kicker {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(21, 152, 255, .08);
        color: #1598ff;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin: 0 0 14px;
    }

    .privacy-title {
        color: #0b1f33;
        font-size: 52px;
        line-height: 1.05;
        font-weight: 900;
        letter-spacing: -.04em;
        margin: 0 0 18px;
    }

    .privacy-lead {
        color: #4e5d78;
        font-size: 18px;
        line-height: 1.65;
        max-width: 980px;
        margin: 0;
    }

    .privacy-updated {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 20px;
        padding: 10px 14px;
        border-radius: 14px;
        border: 1px solid #e7edf5;
        color: #334155;
        background: #ffffff;
        font-size: 14px;
        font-weight: 700;
        box-shadow: 0 8px 24px rgba(16, 54, 92, .04);
    }

    .privacy-updated i {
        color: #ef233c;
    }

    .privacy-layout {
        display: grid;
        grid-template-columns: 300px minmax(0, 1fr);
        gap: 34px;
        align-items: start;
    }

    .privacy-sidebar {
        position: sticky;
        top: 108px;
        padding: 22px;
        border: 1px solid #e7edf5;
        border-radius: 20px;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(16, 54, 92, .045);
    }

    .privacy-sidebar-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #0b1f33;
        font-size: 16px;
        font-weight: 900;
        margin-bottom: 14px;
    }

    .privacy-sidebar-title i {
        color: #ef233c;
        font-size: 20px;
    }

    .privacy-toc {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 9px;
    }

    .privacy-toc a {
        color: #4e5d78;
        font-size: 14px;
        line-height: 1.35;
        font-weight: 700;
        text-decoration: none;
        transition: color .2s ease;
    }

    .privacy-toc a:hover {
        color: #1598ff;
    }

    .privacy-content {
        display: grid;
        gap: 22px;
    }

    .privacy-section {
        padding: 28px;
        border: 1px solid #e7edf5;
        border-radius: 22px;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(16, 54, 92, .04);
    }

    .privacy-section h2 {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #0b1f33;
        font-size: 28px;
        line-height: 1.18;
        font-weight: 900;
        letter-spacing: -.025em;
        margin: 0 0 16px;
    }

    .privacy-section h2 i {
        color: #ef233c;
        font-size: 26px;
        flex: 0 0 auto;
    }

    .privacy-section h3 {
        color: #0b1f33;
        font-size: 18px;
        line-height: 1.35;
        font-weight: 900;
        margin: 20px 0 8px;
    }

    .privacy-section p {
        color: #4e5d78;
        font-size: 16px;
        line-height: 1.75;
        margin: 0 0 14px;
    }

    .privacy-section p:last-child {
        margin-bottom: 0;
    }

    .privacy-list {
        list-style: none;
        padding: 0;
        margin: 12px 0 0;
        display: grid;
        gap: 10px;
    }

    .privacy-list li {
        position: relative;
        color: #4e5d78;
        font-size: 16px;
        line-height: 1.65;
        padding-left: 28px;
    }

    .privacy-list li::before {
        content: "✓";
        position: absolute;
        left: 0;
        top: 0;
        color: #ef233c;
        font-weight: 900;
    }

    .privacy-note {
        display: flex;
        gap: 16px;
        align-items: flex-start;
        margin-top: 18px;
        padding: 20px 22px;
        border: 1px solid #e7edf5;
        border-left: 4px solid #ef233c;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(16, 54, 92, .045);
    }

    .privacy-note i {
        color: #ef233c;
        font-size: 22px;
        margin-top: 2px;
    }

    .privacy-note p {
        color: #0b1f33;
        font-weight: 700;
        margin: 0;
    }

    .privacy-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        overflow: hidden;
        border: 1px solid #e7edf5;
        border-radius: 16px;
        margin-top: 14px;
    }

    .privacy-table th,
    .privacy-table td {
        padding: 15px 16px;
        vertical-align: top;
        border-bottom: 1px solid #e7edf5;
        color: #4e5d78;
        font-size: 15px;
        line-height: 1.55;
    }

    .privacy-table th {
        color: #0b1f33;
        font-weight: 900;
        background: #f8fbff;
    }

    .privacy-table tr:last-child td {
        border-bottom: 0;
    }

    .privacy-contact-box {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-top: 18px;
    }

    .privacy-contact-card {
        padding: 18px;
        border: 1px solid #e7edf5;
        border-radius: 18px;
        background: #ffffff;
    }

    .privacy-contact-card i {
        display: block;
        color: #ef233c;
        font-size: 24px;
        margin-bottom: 10px;
    }

    .privacy-contact-card strong {
        display: block;
        color: #0b1f33;
        font-size: 15px;
        font-weight: 900;
        margin-bottom: 4px;
    }

    .privacy-contact-card span,
    .privacy-contact-card a {
        color: #4e5d78;
        font-size: 14px;
        line-height: 1.45;
        text-decoration: none;
        word-break: break-word;
    }

    .privacy-contact-card a:hover {
        color: #1598ff;
    }

    @@media (max-width: 991px) {
        .privacy-layout {
            grid-template-columns: 1fr;
        }

        .privacy-sidebar {
            position: relative;
            top: auto;
        }

        .privacy-title {
            font-size: 40px;
        }

        .privacy-contact-box {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575px) {
        .privacy-section {
            padding: 22px;
        }

        .privacy-title {
            font-size: 34px;
        }

        .privacy-table {
            display: block;
            overflow-x: auto;
        }
    }
</style>

<main class="main">
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0" data-i18n="privacy.pageTitle">Privacy Policy</h1>

            <nav class="breadcrumbs">
                <ol>
                    <li><a href="/" data-i18n="nav.home">Home</a></li>
                    <li class="current" data-i18n="privacy.pageTitle">Privacy Policy</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="container">
        <section class="blog-details section" id="blog-details">
            <div class="container">
                <article class="article">
                    <div class="privacy-page">

                        <section class="privacy-hero">
                            <div class="privacy-kicker" data-i18n="privacy.kicker">GDPR / EU Data Protection</div>
                            <h1 class="privacy-title" data-i18n="privacy.hero.title">Privacy Policy</h1>
                            <p class="privacy-lead" data-i18n="privacy.hero.lead">This Privacy Policy explains how STATANLY Tech Global collects, uses, stores and protects personal data when you visit our website, contact us, request information, use our services or interact with our AI platform.</p>

                            <div class="privacy-updated">
                                <i class="bi bi-calendar-check"></i>
                                <span data-i18n="privacy.lastUpdated">Last updated: 30 May 2026</span>
                            </div>
                        </section>

                        <div class="privacy-layout">
                            <aside class="privacy-sidebar">
                                <div class="privacy-sidebar-title">
                                    <i class="bi bi-list-check"></i>
                                    <span data-i18n="privacy.toc.title">Contents</span>
                                </div>

                                <ul class="privacy-toc">
                                    <li><a href="#controller" data-i18n="privacy.toc.controller">Data controller</a></li>
                                    <li><a href="#data" data-i18n="privacy.toc.data">Data we process</a></li>
                                    <li><a href="#purposes" data-i18n="privacy.toc.purposes">Purposes and legal bases</a></li>
                                    <li><a href="#cookies" data-i18n="privacy.toc.cookies">Cookies and analytics</a></li>
                                    <li><a href="#sharing" data-i18n="privacy.toc.sharing">Sharing and transfers</a></li>
                                    <li><a href="#retention" data-i18n="privacy.toc.retention">Retention</a></li>
                                    <li><a href="#rights" data-i18n="privacy.toc.rights">Your rights</a></li>
                                    <li><a href="#security" data-i18n="privacy.toc.security">Security</a></li>
                                    <li><a href="#contacts" data-i18n="privacy.toc.contacts">Contacts</a></li>
                                </ul>
                            </aside>

                            <div class="privacy-content">

                                <section class="privacy-section" id="controller">
                                    <h2><i class="bi bi-building"></i><span data-i18n="privacy.controller.title">1. Who we are</span></h2>
                                    <p data-i18n="privacy.controller.p1">STATANLY Techn Global develops an enterprise AI platform for video, audio and event analytics. For the purposes of this Privacy Policy, “STATANLY”, “we”, “us” or “our” means the company operating this website and providing information about STATANLY products and services.</p>
                                    <p data-i18n="privacy.controller.p2">Where we collect personal data through this website, contact forms, business communications, demo requests or marketing interactions, we normally act as the data controller. Where our platform is deployed for a customer and processes personal data on the customer’s behalf, the customer is usually the controller and STATANLY may act as a processor under a separate data processing agreement.</p>

                                    <div class="privacy-contact-box">
                                        <div class="privacy-contact-card">
                                            <i class="bi bi-envelope"></i>
                                            <strong data-i18n="privacy.controller.emailTitle">Privacy contact</strong>
                                            <a href="mailto:hello@statanly.com">hello@statanly.eu</a>
                                        </div>
                                        <div class="privacy-contact-card">
                                            <i class="bi bi-geo-alt"></i>
                                            <strong data-i18n="privacy.controller.locationTitle">Location</strong>
                                            <span data-i18n="privacy.controller.locationText">Praça do Comércio, 1100-148 Lisbon, Portugal / European Union</span>
                                        </div>
                                        <div class="privacy-contact-card">
                                            <i class="bi bi-shield-check"></i>
                                            <strong data-i18n="privacy.controller.dpoTitle">Data protection contact</strong>
                                            <span data-i18n="privacy.controller.dpoText">Please contact us by email for privacy and data protection requests.</span>
                                        </div>
                                    </div>
                                </section>

                                <section class="privacy-section" id="data">
                                    <h2><i class="bi bi-database"></i><span data-i18n="privacy.data.title">2. Personal data we may process</span></h2>
                                    <p data-i18n="privacy.data.p1">Depending on how you interact with us, we may process the following categories of personal data:</p>
                                    <ul class="privacy-list">
                                        <li data-i18n="privacy.data.li1">Business contact details, such as name, company, role, email address, phone number and country.</li>
                                        <li data-i18n="privacy.data.li2">Information you submit through website forms, emails, demo requests, commercial discussions or support requests.</li>
                                        <li data-i18n="privacy.data.li3">Technical data, such as IP address, browser type, device information, approximate location, pages visited, timestamps and website usage data.</li>
                                        <li data-i18n="privacy.data.li4">Communication data, such as correspondence history, meeting notes, requests, feedback and commercial preferences.</li>
                                        <li data-i18n="privacy.data.li5">Contract and transaction data where we enter into a business relationship with your organisation.</li>
                                    </ul>
                                </section>

                                <section class="privacy-section" id="purposes">
                                    <h2><i class="bi bi-diagram-3"></i><span data-i18n="privacy.purposes.title">3. Why we process personal data</span></h2>
                                    <p data-i18n="privacy.purposes.p1">We process personal data only where we have a lawful basis under applicable data protection law. The main purposes and legal bases are:</p>

                                    <table class="privacy-table">
                                        <thead>
                                            <tr>
                                                <th data-i18n="privacy.table.purpose">Purpose</th>
                                                <th data-i18n="privacy.table.legalBasis">Legal basis</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td data-i18n="privacy.purpose.contact">Responding to inquiries, demo requests and business communications.</td>
                                                <td data-i18n="privacy.basis.legitimate">Legitimate interests or steps prior to entering into a contract.</td>
                                            </tr>
                                            <tr>
                                                <td data-i18n="privacy.purpose.services">Providing products, services, support, documentation and customer communications.</td>
                                                <td data-i18n="privacy.basis.contract">Performance of a contract or legitimate interests.</td>
                                            </tr>
                                            <tr>
                                                <td data-i18n="privacy.purpose.marketing">Sending relevant business updates, product information or event invitations.</td>
                                                <td data-i18n="privacy.basis.consentOrLegitimate">Consent where required, or legitimate interests for B2B communications.</td>
                                            </tr>
                                            <tr>
                                                <td data-i18n="privacy.purpose.website">Operating, securing and improving the website and understanding how it is used.</td>
                                                <td data-i18n="privacy.basis.legitimateOrConsent">Legitimate interests or consent where required for cookies and analytics.</td>
                                            </tr>
                                            <tr>
                                                <td data-i18n="privacy.purpose.legal">Complying with legal, accounting, tax, security and compliance obligations.</td>
                                                <td data-i18n="privacy.basis.legal">Legal obligation and legitimate interests.</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </section>

                                <section class="privacy-section" id="cookies">
                                    <h2><i class="bi bi-cookie"></i><span data-i18n="privacy.cookies.title">4. Cookies and similar technologies</span></h2>
                                    <p data-i18n="privacy.cookies.p1">We may use cookies and similar technologies to operate the website, remember user preferences, understand website performance and improve our content. Where required by law, we ask for your consent before using non-essential cookies.</p>
                                    <p data-i18n="privacy.cookies.p2">You can usually control cookies through your browser settings. Disabling some cookies may affect website functionality.</p>
                                </section>

                                <section class="privacy-section" id="sharing">
                                    <h2><i class="bi bi-share"></i><span data-i18n="privacy.sharing.title">5. Sharing personal data</span></h2>
                                    <p data-i18n="privacy.sharing.p1">We do not sell personal data. We may share personal data with trusted service providers and business partners where necessary to operate the website, provide services, manage customer relationships, process communications, host infrastructure, provide analytics, comply with legal obligations or protect our rights.</p>
                                    <p data-i18n="privacy.sharing.p2">Where personal data is transferred outside the European Economic Area, we use appropriate safeguards where required, such as adequacy decisions, standard contractual clauses or other lawful transfer mechanisms.</p>
                                </section>

                                <section class="privacy-section" id="retention">
                                    <h2><i class="bi bi-clock-history"></i><span data-i18n="privacy.retention.title">6. How long we keep personal data</span></h2>
                                    <p data-i18n="privacy.retention.p1">We keep personal data only for as long as necessary for the purposes described in this Privacy Policy, including to respond to requests, maintain business records, provide services, comply with legal obligations, resolve disputes and enforce agreements.</p>
                                    <p data-i18n="privacy.retention.p2">Retention periods may vary depending on the type of data, the nature of our relationship with you or your organisation, legal requirements and legitimate business needs.</p>
                                </section>

                                <section class="privacy-section" id="rights">
                                    <h2><i class="bi bi-person-check"></i><span data-i18n="privacy.rights.title">7. Your data protection rights</span></h2>
                                    <p data-i18n="privacy.rights.p1">Subject to applicable law, you may have the following rights in relation to your personal data:</p>
                                    <ul class="privacy-list">
                                        <li data-i18n="privacy.rights.li1">Right of access to your personal data.</li>
                                        <li data-i18n="privacy.rights.li2">Right to rectification of inaccurate or incomplete data.</li>
                                        <li data-i18n="privacy.rights.li3">Right to erasure of personal data in certain circumstances.</li>
                                        <li data-i18n="privacy.rights.li4">Right to restriction of processing.</li>
                                        <li data-i18n="privacy.rights.li5">Right to object to processing based on legitimate interests or direct marketing.</li>
                                        <li data-i18n="privacy.rights.li6">Right to data portability where processing is based on consent or contract and carried out by automated means.</li>
                                        <li data-i18n="privacy.rights.li7">Right to withdraw consent at any time where processing is based on consent.</li>
                                        <li data-i18n="privacy.rights.li8">Right to lodge a complaint with a competent data protection supervisory authority.</li>
                                    </ul>

                                    <div class="privacy-note">
                                        <i class="bi bi-stars"></i>
                                        <p data-i18n="privacy.rights.note">To exercise your rights, contact us at hello@statanly.eu. We may need to verify your identity before responding to a request.</p>
                                    </div>
                                </section>

                                <section class="privacy-section" id="security">
                                    <h2><i class="bi bi-lock"></i><span data-i18n="privacy.security.title">8. Security</span></h2>
                                    <p data-i18n="privacy.security.p1">We apply organisational and technical measures designed to protect personal data against accidental or unlawful destruction, loss, alteration, unauthorised disclosure or access. These measures may include access controls, secure infrastructure, encryption where appropriate, logging, backup procedures and internal security rules.</p>
                                    <p data-i18n="privacy.security.p2">No method of transmission or storage is completely secure. We continuously work to improve the security of our systems and processes.</p>
                                </section>

                                <section class="privacy-section" id="ai">
                                    <h2><i class="bi bi-cpu"></i><span data-i18n="privacy.ai.title">9. AI platform and customer deployments</span></h2>
                                    <p data-i18n="privacy.ai.p1">STATANLY products may be deployed in customer environments to analyse video, audio, operational events or other data sources. In such cases, the customer normally determines the purposes and means of processing and is responsible for providing notices, obtaining lawful bases and configuring the system in accordance with applicable law.</p>
                                    <p data-i18n="privacy.ai.p2">Where STATANLY processes personal data on behalf of a customer, we do so under the customer’s instructions and under an appropriate data processing agreement.</p>
                                </section>

                                <section class="privacy-section" id="changes">
                                    <h2><i class="bi bi-arrow-repeat"></i><span data-i18n="privacy.changes.title">10. Changes to this Privacy Policy</span></h2>
                                    <p data-i18n="privacy.changes.p1">We may update this Privacy Policy from time to time to reflect changes in our website, services, technologies, legal requirements or business processes. The latest version will be published on this page.</p>
                                </section>

                                <section class="privacy-section" id="contacts">
                                    <h2><i class="bi bi-envelope-paper"></i><span data-i18n="privacy.contacts.title">11. Contact us</span></h2>
                                    <p data-i18n="privacy.contacts.p1">If you have any questions about this Privacy Policy or how we process personal data, please contact us:</p>
                                    <div class="privacy-contact-box">
                                        <div class="privacy-contact-card">
                                            <i class="bi bi-envelope"></i>
                                            <strong data-i18n="privacy.contacts.email">Email</strong>
                                            <a href="mailto:hello@statanly.eu">hello@statanly.eu</a>
                                        </div>
                                        <div class="privacy-contact-card">
                                            <i class="bi bi-globe2"></i>
