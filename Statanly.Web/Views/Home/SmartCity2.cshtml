@{
    Layout = "/Views/Shared/_SolutionsLayout.cshtml";
}
<main id="main">

    <!-- ======= Breadcrumbs ======= -->
    <section id="breadcrumbs" class="breadcrumbs">
        <div class="container">

            <ol>
                <li><a href="/#smart">Главная</a></li>
                <li>Общественная безопасность</li>
            </ol>
        </div>
    </section><!-- End Breadcrumbs -->
    <!-- ======= Blog Single Section ======= -->
    <section id="blog" class="blog">
        <div class="container">
            <div class="section-title">
                <h2>Общественная безопасность</h2>
                <p>
                    Интеллектуальная система мониторинга общественной безопасности
                </p>
            </div>
            <div class="row">
                <div class="col-lg-4 entries">
                    <article class="entry entry-single">
                        <div class="entry-img">
                            <img src="~/assets/img/Smart city/Public safety/1.png" alt="" class="img-fluid">
                        </div>
                        <h2 class="entry-title">
                            Граффити
                        </h2>
                        <div class="entry-content">
                            <p>
                                Обнаружение незаконных граффити, надписей, вандализма
                            </p>
                        </div>
                    </article>
                </div>
                <div class="col-lg-4 entries">
                    <article class="entry entry-single">
                        <div class="entry-img">
                            <img src="~/assets/img/Smart city/Public safety/2.gif" alt="" class="img-fluid">
                        </div>
                        <h2 class="entry-title">
                            Драки
                        </h2>
                        <div class="entry-content">
                            <p>
                                Выявление драк, столкновений, нарушений общественной безопасности
                            </p>
                        </div>
                    </article>
                </div>
                <div class="col-lg-4 entries">
                    <article class="entry entry-single">
                        <div class="entry-img">
                            <img src="~/assets/img/Smart city/Public safety/3.gif" alt="" class="img-fluid">
                        </div>
                        <h2 class="entry-title">
                            ДТП
                        </h2>
                        <div class="entry-content">
                            <p>
                                Выявление дорожно-транспортных происшествий, столкновений транспортных средств
                            </p>
                        </div>
                    </article>
                </div>
            </div>
        </div>
    </section>
</main><!-- End #main -->
