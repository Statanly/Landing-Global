@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options

@inject IViewLocalizer Localizer
@{
    Layout = "/Views/Shared/_SolutionsLayout.cshtml";
}
<!-- ======= Breadcrumbs ======= -->
<section id="breadcrumbs" class="breadcrumbs">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center">
            <ol>
                <li><a href="/#services">Главная</a></li>
                <li>Типовые решения</li>
            </ol>
        </div>

    </div>
</section><!-- End Breadcrumbs -->
<!-- ======= Portfolio Details Section ======= -->
<section id="portfolio-details" class="portfolio-details">
    <div class="container">

        <div class="row gy-4">
            <div class="col-lg-12">
                <div class="portfolio-info">
                    <h3>Типовые решения на базе машинного обучения и компьютерного зрения</h3>
                    <p>
                        Компания имеет большое количество готовых алгоритмов и предобученных моделей, которые могут быть внедрены
                        в кратчайшие сроки и адаптирваны под конкретные условия заказчика. Донастройка (дообучение) моделей позволяет
                        достич максимальной точности и качества системы, а кастомизация типовой системы позволяет адаптировать ее
                        под любые требования и пожелания заказчика.
                        </br>
                        Среди типовых решений выделим следующие:
                    </p>
                    <div class="row gy-4">
                        <div class="col-lg-6">
                            <div class="portfolio-description">
                                <p>
                                    <strong>Подсчет объектов</strong>
                                </p>
                                <p>
                                    Подсчет различных объектов, в том числе - людей в очереди, транспортных средств на дорогах, объектов на производственной линии и т.д.
                                </p>
                                <p>
                                    <strong>Обнаружение поверхностных дефектов</strong>
                                </p>
                                <p>
                                    Распознавание дефектов, повреждения, загрязнений, посторонних включений.
                                </p>
                                <p>
                                    <strong>Классификация объектов по типу</strong>
                                </p>
                                <p>
                                    Распознавание лиц, классификация транспортных средств, марок автомобилей и т.д.
                                </p>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="portfolio-description">
                                <p>
                                    <strong>Контроль нанесения маркировки</strong>
                                </p>
                                <p>
                                    Распознавание текста (надписи, маркировки, qr-коды). Контроль правильного нанесения информации, положения этикеток на продукции.
                                </p>
                                <p>
                                    <strong>Контроль геометрических размеров</strong>
                                </p>
                                <p>
                                    Распознавание размера, формы, габаритов различных объектов.
                                </p>
                                <p>
                                    <strong>Определение гранулометрического состава</strong>
                                </p>
                                <p>
                                    Определение гранулометрического состава различных вещест по размерам, цвету и т.д.
                                </p>
                            </div>
                        </div>
                        <div class="portfolio-description">
                            <p>
                                <strong>Примеры внедрений:</strong>
                            </p>
                            <div class="row">
                                <div class="col-md-6 d-flex align-items-stretch">
                                    <ul>
                                        <li>
                                            Контроль качества в металлообработке (металлопрокат)
                                        </li>
                                        <li>
                                            Контроль качества бумаги, картона, листового полипропилена
                                        </li>
                                        <li>
                                            Контроль сыпучих материалов и горных пород (задача гранулометрии)
                                        </li>
                                    </ul>
                                </div>
                                <div class="col-md-6 d-flex align-items-stretch">
                                    <ul>
                                        <li>
                                            Дефекты дорожного покрытия (ямы, канавы, нарушение разметки и т.д.)
                                        </li>
                                        <li>
                                            Распознавание номеров ТС
                                        </li>
                                        <li>
                                            Распознавание лиц, подсчет людей, автомобилей в очереди и на дорогах
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section><!-- End Portfolio Details Section -->
