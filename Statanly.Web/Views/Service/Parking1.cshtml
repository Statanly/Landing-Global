@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    Layout = "/Views/Shared/_SolutionsLayout.cshtml";
}
<main id="main">
    <!-- ======= Breadcrumbs ======= -->
    <section id="breadcrumbs" class="breadcrumbs">
        <div class="container">
            <ol>
                <li><a href="/home/services">Все сервисы</a></li>
                <li><a href="/service/restaurants">Рестораны</a></li>
                <li><a href="/service/shops">Магазины</a></li>
                <li><a href="/service/housing">ЖКХ</a></li>
                <li><a href="/service/railwaystation">Аэропорты и вокзалы</a></li>
                <li><a href="/service/shoppingmalls">ТРЦ & ТРК</a></li>
                <li><a href="/service/parking ">Парковки</a></li>
                <li><a href="/service/banks">Банки</a></li>
                <li><a href="/service/pvz">ПВЗ</a></li>
                <li><a href="/service/warehouses">Склады</a></li>
                <li><a href="/service/Business ">Бизнес-центры</a></li>
                <li><a href="/service/beauty ">Салоны красоты</a></li>
                <li><a href="/service/industry">Производство</a></li>
                <li><a href="/service/hospitals">Медицинские учреждения</a></li>
            </ol>
            <h2>Умный шлагбаум</h2>
        </div>
    </section><!-- End Breadcrumbs -->

    <section id="cta" class="cta">
        <div class="container">

            <div class="row" data-aos="zoom-in">
                <div class="col-lg-9 text-center text-lg-start">
                    <h3>Умная пропускная система</h3>
                    <p>Интеллектуальная система пропуска автомобилей, спец. транспорта в паркинги и придомовую территорию</p>
                </div>
                <div class="col-lg-3 cta-btn-container text-center">
                    <a class="cta-btn align-middle" href="/home/contact">Оставить заявку</a>
                </div>
            </div>
        </div>
    </section><!-- End Cta Section -->
    <!-- ======= Portfolio Details Section ======= -->
    <section id="portfolio-details" class="portfolio-details">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-6">
                    <div class="portfolio-details-slider">
                        <div class="align-items-center">
                            <div class="swiper-slide">
                                <img src="~/assets/img/Services/Housing/1.png" alt="">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="portfolio-description">
                        <h2>Система компьютерного зрения</h2>
                        <p>
                            Включает в себя IP-камеры для анализа видеоданных по автомобилям и программного обеспечение для обработки информации.
                        </p>
                        <p>
                            Система позволяет использовать простые, недорогие видеокамеры и серверное оборудование или облачные вычисления.
                        </p>
                        <p>
                            Система состоит из целого набора моделей:
                        </p>
                        <ol>
                            <li>Распознавание <strong>номерного знака</strong> автомобиля</li>
                            <li>Распознавание автомобиля по дополнительным признакам (<strong>марка</strong>, <strong>модель</strong>, <strong>цвет</strong>, <strong>тип кузова</strong>)</li>
                            <li>Детекция специальных транспортных средств по цветовой схеме (<strong>скорая помощь</strong>, <strong>пожарная</strong>, <strong>милиция</strong>)</li>
                            <li>Детекция при <strong>сильном загрязнении</strong> номерного знака и плохих внешних условиях (дождь, снег, плохая освещенность)</li>
                        </ol>
                    </div>
                </div>
            </div>
            <div class="row gy-4">
                <div class="col-lg-6">
                    <div class="portfolio-description">
                        <h2>Принцип работы</h2>
                        <ol>
                            <li>
                                Автомобиль подъезжает к шлагбауму и попадает в зону видимости видеокамеры
                            </li>
                            <li>
                                Распознавание автомобиля: определяются номерной знак, марка, модель, цвет, тип кузова автомобиля
                            </li>
                            <li>Распознавание автомобиля по дополнительным признакам (марка, модель, цвет, тип кузова)</li>
                            <li>
                                Проверка по списку разрешенных и сравнение распознанных признаков автомобиля с базой данных
                            </li>
                            <li>
                                Открытие шлагбаума для разрешенных автомобилей и спецтранспорта
                            </li>
                        </ol>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="portfolio-details-slider">
                        <div class="align-items-center">
                            <div class="swiper-slide">
                                <img src="~/assets/img/Services/Housing/2.png" alt="">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section><!-- End Portfolio Details Section -->
    <!-- ======= Services Section ======= -->
    <section id="services" class="services">
        <div class="container">
            <div class="section-title">
                <h2>Особенности системы</h2>
            </div>
            <div class="row">
                <div class="col-md-6 d-flex align-items-stretch">
                    <div class="icon-box">
                        <i class="bi bi-1-circle"></i>
                        <h4>Автоматическое открытие шлагбаума для жителей</h4>
                        <p>Шлагбаум откроется автоматически без каких-либо действий водител</p>
                    </div>
                </div>
                <div class="col-md-6 d-flex align-items-stretch mt-4 mt-md-0">
                    <div class="icon-box">
                        <i class="bi bi-2-circle"></i>
                        <h4>Автоматическое распознавание спецтранспорта</h4>
                        <p>
                            Для скорых, милиции, МЧС шлагбаум откроется автоматически
                        </p>
                    </div>
                </div>
                <div class="col-md-6 d-flex align-items-stretch mt-4 mt-md-0">
                    <div class="icon-box">
                        <i class="bi bi-3-circle"></i>
                        <h4>Управление правами доступа в один клик</h4>
                        <p>Не нужно встречаться с пользователем, чтобы предоставить ему возможность проезда</p>
                    </div>
                </div>
                <div class="col-md-6 d-flex align-items-stretch mt-4 mt-md-0">
                    <div class="icon-box">
                        <i class="bi bi-4-circle"></i>
                        <h4>Контроль проездов на территорию</h4>
                        <p>Отчет по "чужим" автомобилям, припарковавшимся на ночь</p>
                    </div>
                </div>
                <div class="col-md-6 d-flex align-items-stretch mt-4 mt-md-0">
                    <div class="icon-box">
                        <i class="bi bi-5-circle"></i>
                        <h4>Надежность работы в сложных погодных условиях</h4>
                        <p>
                            Качество работы системы не снижается в осенне-зимний период
                        </p>
                    </div>
                </div>
                <div class="col-md-6 d-flex align-items-stretch mt-4 mt-md-0">
                    <div class="icon-box">
                        <i class="bi bi-6-circle"></i>
                        <h4>Снижение расходов на эксплуатацию</h4>
                        <p>
                            Нет необходимости в контроле системы со стороны диспетчера
                        </p>
                    </div>
                </div>
                <div class="col-md-6 d-flex align-items-stretch mt-4 mt-md-0">
                    <div class="icon-box">
                        <i class="bi bi-7-circle"></i>
                        <h4>Круглосуточная техническая поддержка</h4>
                        <p>
                            Проблемы наших клиентов - наши проблемы! Обеспечим полный стек техподдержки
                        </p>
                    </div>
                </div>
                <div class="col-md-6 d-flex align-items-stretch mt-4 mt-md-0">
                    <div class="icon-box">
                        <i class="bi bi-8-circle"></i>
                        <h4>Монетизация парковочных мест</h4>
                        <p>
                            Возможность выставления ежемесячного счета за парковку на территории вашего дома
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section><!-- End Services Section -->
    <section id="smart" class="smart">
        <div class="container">
            <div class="section-title">
                <h2>Варианты поставки ПО</h2>
                <p>

                </p>
            </div>
            <div class="row">
                <div class="col-lg-6 col-md-6 d-flex align-items-stretch">
                    <div class="member" style="margin: 0 auto;">
                        <a tabindex="-1" href=""><img src="/assets/img/Services/cloud.png" alt=""></a>
                        <h4> <a tabindex="-1" href="">Cloud</a></h4>
                        <p>Развертывание ПО в нашем облаке, удаленный доступ</p>

                    </div>
                </div>
                <div class="col-lg-6 col-md-6 d-flex align-items-stretch">
                    <div class="member" style="margin: 0 auto;">
                        <a tabindex="-1" href=""><img src="/assets/img/Services/OnPermise.png" alt=""></a>
                        <h4> <a tabindex="-1" href="">On-Premise</a></h4>
                        <p>Развертывание ПО на внутренних ресурсах компании</p>

                    </div>
                </div>
            </div>
        </div>
    </section>
</main><!-- End #main -->
