                <div class="col-lg-2 col-md-6 d-flex align-items-stretch">

                </div>
                <div class="col-lg-5 col-md-5 d-flex align-items-stretch">
                    <div class="member">
                        <a tabindex="-1" href=""><img src="/assets/img/Services/OnPermise.jpg" alt=""></a>
                        <h4><a tabindex="-1" href="">On-Premise</a></h4>
                        <p>Развертывание ПО на внутренних ресурсах компании</p>
                    </div>
