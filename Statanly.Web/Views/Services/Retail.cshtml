<style>
        /* =========================================================
       RETAIL AI PLATFORM — FINAL CLEAN VERSION
       Palette: template blue + restrained red accent
    ========================================================= */

        /* ---------- HERO ---------- */
        .retail-hero-section {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 42%;
            gap: 28px;
            align-items: start;
            margin: 0 0 38px;
            padding: 0;
            background: #ffffff;
            overflow: visible;
        }

        .retail-hero-content {
            position: relative;
            z-index: 2;
            min-width: 0;
            padding: 0 18px 0 0;
        }

        .retail-kicker,
        .retail-section-kicker {
            display: inline-flex;
            align-items: center;
            padding: 8px 14px;
            border-radius: 999px;
            background: rgba(21, 152, 255, .08);
            color: #1598ff;
            font-size: 13px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

        .retail-kicker {
            margin-bottom: 14px;
        }

        .retail-hero-title {
            color: #0b1f33;
            font-size: 56px;
            line-height: 1.04;
            font-weight: 900;
            letter-spacing: -.045em;
            margin: 0 0 22px;
            max-width: 760px;
        }

        .retail-meta-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
            max-width: 760px;
            margin-bottom: 30px;
        }

        .retail-meta-card {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            min-height: 88px;
            padding: 18px 16px;
            background: #ffffff;
            border: 1px solid #eef2f7;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(16,54,92,.04), 0 2px 10px rgba(16,54,92,.03);
        }

            .retail-meta-card i {
                color: #1598ff;
                font-size: 24px;
                flex-shrink: 0;
                margin-top: 2px;
            }

            .retail-meta-card span {
                color: #334155;
                font-size: 14px;
                line-height: 1.55;
                font-weight: 700;
            }

        .retail-intro-text {
            max-width: 900px;
        }

            .retail-intro-text p {
                color: #4e5d78;
                font-size: 18px;
                line-height: 1.85;
                margin: 0 0 16px;
            }

                .retail-intro-text p:last-child {
                    margin-bottom: 0;
                }

        .retail-hero-visual {
            position: relative;
            z-index: 1;
            width: 100%;
            height: 520px;
            pointer-events: none;
            overflow: visible;
        }

            .retail-hero-visual img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: center right;
                display: block;
                -webkit-mask-image: linear-gradient(to left, rgba(0,0,0,1) 50%, rgba(0,0,0,.86) 62%, rgba(0,0,0,.48) 78%, rgba(0,0,0,0) 100%), linear-gradient(to bottom, rgba(0,0,0,1) 82%, rgba(0,0,0,.55) 94%, rgba(0,0,0,0) 100%);
                -webkit-mask-composite: source-in;
                mask-image: linear-gradient(to left, rgba(0,0,0,1) 50%, rgba(0,0,0,.86) 62%, rgba(0,0,0,.48) 78%, rgba(0,0,0,0) 100%), linear-gradient(to bottom, rgba(0,0,0,1) 82%, rgba(0,0,0,.55) 94%, rgba(0,0,0,0) 100%);
            }

        /* ---------- SECTION HEADERS ---------- */
        .retail-section-kicker {
            margin-bottom: 14px;
        }

        .retail-section-title {
            color: #0b1f33;
            font-size: 42px;
            line-height: 1.12;
            font-weight: 900;
            letter-spacing: -.03em;
            margin: 0 0 16px;
        }

        .retail-section-lead {
            color: #4e5d78;
            font-size: 18px;
            line-height: 1.75;
            max-width: 920px;
            margin: 0 0 26px;
        }

        /* ---------- MODULES ---------- */
        .retail-modules-section {
            margin: 34px 0 34px;
        }

        .retail-modules-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 24px;
        }

        .retail-module-card {
            position: relative;
            display: flex;
            flex-direction: column;
            background: #ffffff;
            border: 1px solid #e7edf5;
            border-radius: 20px;
            padding: 30px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(16,54,92,.045), 0 2px 10px rgba(16,54,92,.025);
            transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        }

            .retail-module-card::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 4px;
                background: #ef233c;
            }

            .retail-module-card:hover {
                transform: translateY(-4px);
                border-color: rgba(239,35,60,.18);
                box-shadow: 0 22px 50px rgba(16,54,92,.08), 0 8px 18px rgba(16,54,92,.04);
            }

        .retail-module-head {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            margin-bottom: 22px;
        }

        .retail-module-icon {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            background: rgba(239,35,60,.07);
            color: #ef233c;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .retail-module-icon i {
                font-size: 28px;
            }

        .retail-module-card h3 {
            color: #0b1f33;
            font-size: 24px;
            line-height: 1.22;
            font-weight: 850;
            margin: 3px 0 0;
        }

        .retail-module-card ul {
            list-style: none;
            padding: 0;
            margin: 0 0 24px;
        }

        .retail-module-card li {
            position: relative;
            padding-left: 28px;
            color: #4e5d78;
            font-size: 15.5px;
            line-height: 1.62;
            margin-bottom: 11px;
        }

            .retail-module-card li::before {
                content: "✓";
                position: absolute;
                left: 0;
                top: 0;
                color: #ef233c;
                font-weight: 900;
            }

        .retail-module-metrics {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
            margin-top: auto;
            padding-top: 18px;
            border-top: 1px solid #eef2f7;
        }

        .retail-metric-pill {
            display: grid;
            grid-template-columns: 28px minmax(0, 1fr);
            grid-template-rows: auto auto;
            column-gap: 10px;
            row-gap: 2px;
            align-items: center;
            min-width: 0;
            min-height: 72px;
            padding: 12px 14px;
            background: #ffffff;
            border: 1px solid #e7edf5;
            border-radius: 14px;
        }

            .retail-metric-pill i {
                grid-row: 1 / 3;
                color: #ef233c;
                font-size: 22px;
                width: 28px;
                text-align: center;
            }

            .retail-metric-pill span {
                display: block;
                min-width: 0;
                color: #64748b;
                font-size: 12px;
                line-height: 1.2;
                font-weight: 700;
            }

            .retail-metric-pill strong {
                display: block;
                min-width: 0;
                color: #0b1f33;
                font-size: 15px;
                line-height: 1.2;
                font-weight: 900;
                white-space: normal;
            }

        /* ---------- PLATFORM SECTION ---------- */
        .retail-platform-section {
            margin: 42px 0 36px;
        }

        .retail-platform-grid {
            display: grid;
            grid-template-columns: minmax(0, .95fr) minmax(280px, .8fr) minmax(0, .95fr);
            gap: 28px;
            align-items: center;
            margin-top: 30px;
        }

        .retail-platform-side {
            display: flex;
            flex-direction: column;
            gap: 22px;
        }

        .retail-platform-card {
            background: #ffffff;
            border: 1px solid #e7edf5;
            border-radius: 20px;
            padding: 28px;
            min-height: 210px;
            box-shadow: 0 10px 30px rgba(16,54,92,.045), 0 2px 10px rgba(16,54,92,.025);
            transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        }

            .retail-platform-card:hover {
                transform: translateY(-4px);
                border-color: rgba(239,35,60,.16);
                box-shadow: 0 22px 50px rgba(16,54,92,.08), 0 8px 18px rgba(16,54,92,.04);
            }

        .retail-platform-card-icon {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            background: rgba(239,35,60,.07);
            color: #ef233c;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 18px;
        }

            .retail-platform-card-icon i {
                font-size: 28px;
            }

        .retail-platform-card h3 {
            color: #0b1f33;
            font-size: 24px;
            font-weight: 850;
            line-height: 1.22;
            margin: 0 0 12px;
        }

        .retail-platform-card p,
        .retail-platform-card li {
            color: #4e5d78;
            line-height: 1.6;
            font-size: 15.5px;
        }

        .retail-platform-card p {
            margin: 0;
        }

        .retail-platform-card ul {
            margin: 0;
            padding-left: 18px;
        }

        .retail-platform-core {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .retail-platform-core-ring {
            width: 340px;
            height: 340px;
            border-radius: 50%;
            border: 2px solid rgba(21,152,255,.38);
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at center, rgba(21,152,255,.10) 0%, rgba(21,152,255,.04) 48%, rgba(21,152,255,0) 72%);
            box-shadow: inset 0 0 42px rgba(21,152,255,.10), 0 18px 50px rgba(16,54,92,.06);
        }

        .retail-platform-core-inner {
            max-width: 230px;
            text-align: center;
        }

        .retail-core-badge {
            width: 68px;
            height: 68px;
            margin: 0 auto 18px;
            border-radius: 50%;
            background: rgba(21,152,255,.10);
            border: 1px solid rgba(21,152,255,.35);
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .retail-core-badge i {
                color: #1598ff;
                font-size: 32px;
            }

        .retail-platform-core-inner h3 {
            color: #0b1f33;
            font-size: 31px;
            font-weight: 900;
            margin: 0 0 10px;
        }

        .retail-platform-core-inner p {
            color: #4e5d78;
            line-height: 1.55;
            margin: 0;
        }

        .retail-factory {
            margin-top: 30px;
            padding: 26px;
            border: 1px solid #e7edf5;
            border-radius: 20px;
            background: #ffffff;
            box-shadow: 0 10px 30px rgba(16,54,92,.045), 0 2px 10px rgba(16,54,92,.025);
        }

        .retail-factory-title {
            color: #1598ff;
            font-size: 24px;
            font-weight: 850;
            text-align: center;
            margin-bottom: 26px;
        }

        .retail-factory-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 22px;
        }

        .retail-factory-item {
            text-align: center;
        }

            .retail-factory-item i {
                color: #ef233c;
                display: block;
                font-size: 32px;
                margin-bottom: 12px;
            }

            .retail-factory-item span {
                color: #4e5d78;
                font-size: 14.5px;
                line-height: 1.45;
            }

        .retail-deployment-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 22px;
            margin-top: 26px;
        }

        .retail-deployment-card {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            padding: 22px;
            background: #ffffff;
            border: 1px solid #e7edf5;
            border-top: 4px solid #ef233c;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(16,54,92,.045), 0 2px 10px rgba(16,54,92,.025);
        }

            .retail-deployment-card i {
                color: #ef233c;
                font-size: 30px;
                margin-top: 2px;
            }

            .retail-deployment-card h4 {
                color: #0b1f33;
                font-size: 22px;
                font-weight: 850;
                margin: 0 0 6px;
            }

            .retail-deployment-card p {
                color: #4e5d78;
                margin: 0;
                line-height: 1.5;
                font-size: 14.5px;
            }

        .retail-platform-bottom-note {
            margin-top: 28px;
            padding: 24px 28px;
            display: flex;
            gap: 18px;
            align-items: center;
            background: #ffffff;
            border: 1px solid #e7edf5;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(16,54,92,.045), 0 2px 10px rgba(16,54,92,.025);
        }

            .retail-platform-bottom-note i {
                color: #1598ff;
                font-size: 32px;
            }

            .retail-platform-bottom-note span {
                color: #0b1f33;
                font-size: 24px;
                font-weight: 800;
                line-height: 1.35;
            }

        /* ---------- WIDE VISUAL ---------- */
        .retail-visual-section {
            margin: 30px 0 30px;
        }

            .retail-visual-section img {
                width: 100%;
                display: block;
                border-radius: 22px;
                box-shadow: 0 16px 42px rgba(16,54,92,.08), 0 4px 12px rgba(16,54,92,.04);
            }

        /* ---------- INSIGHT / QUOTE ---------- */
        .retail-insight-box {
            margin: 28px 0 0;
            padding: 26px 30px;
            background: #ffffff;
            border: 1px solid #eef2f7;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(16,54,92,.05), 0 2px 10px rgba(16,54,92,.03);
            display: flex;
            align-items: stretch;
            gap: 24px;
        }

        .insight-line {
            width: 4px;
            border-radius: 10px;
            background: linear-gradient(180deg, #1598ff 0%, #ef233c 100%);
            flex-shrink: 0;
        }

        .insight-content {
            display: flex;
            align-items: flex-start;
            gap: 18px;
        }

            .insight-content i {
                color: #1598ff;
                font-size: 30px;
                margin-top: 2px;
                flex-shrink: 0;
            }

            .insight-content p {
                margin: 0;
                color: #26384f;
                font-size: 26px;
                line-height: 1.55;
                font-weight: 700;
            }

        /* ---------- RESPONSIVE ---------- */
        @@media (max-width: 1200px) {
            .retail-hero-section {
                grid-template-columns: 1fr;
            }

            .retail-hero-content {
                padding-right: 0;
            }

            .retail-hero-visual {
                height: 420px;
                margin-top: 20px;
            }

            .retail-modules-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .retail-platform-grid {
                grid-template-columns: 1fr;
            }

            .retail-platform-core-ring {
                width: 300px;
                height: 300px;
            }

            .retail-factory-grid,
            .retail-deployment-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 991px) {
            .retail-hero-title {
                font-size: 40px;
            }

            .retail-section-title {
                font-size: 34px;
            }

            .retail-meta-grid,
            .retail-modules-grid,
            .retail-module-metrics {
                grid-template-columns: 1fr;
            }

            .retail-intro-text p,
            .retail-section-lead {
                font-size: 16px;
                line-height: 1.75;
            }

            .retail-hero-visual {
                height: 320px;
            }

            .retail-platform-bottom-note span,
            .insight-content p {
                font-size: 21px;
            }
        }

        @@media (max-width: 576px) {
            .retail-hero-title {
                font-size: 34px;
            }

            .retail-module-card,
            .retail-platform-card {
                padding: 24px;
            }

            .retail-insight-box,
            .retail-platform-bottom-note {
                padding: 22px;
                gap: 16px;
            }

            .retail-hero-visual {
                height: 260px;
            }

            .insight-content {
                gap: 14px;
            }

                .insight-content i {
                    font-size: 24px;
                }

                .insight-content p {
                    font-size: 18px;
                }
        }
</style>
