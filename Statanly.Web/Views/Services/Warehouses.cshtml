@{ ViewData["Title"] = "Warehouses and Pickup Points"; }
@{ Layout = "/Views/Shared/_ServicesLayout.cshtml"; }
<style>
    /* =========================================================
       WAREHOUSES & PICKUP POINTS PAGE
       Built to sit inside the same blog-details/article template
       as HoReCa, Retail and Industry pages.
       Palette: navy + brand blue + brand red.
    ========================================================= */

    .warehouse-page {
        background: #ffffff;
        color: #172b4d;
    }

    /* ===== HERO ===== */

    .warehouse-hero-section {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 46%;
        gap: 34px;
        align-items: stretch;
        margin: 0 0 32px;
        padding: 0;
        overflow: hidden;
        background: #ffffff;
    }

    .warehouse-hero-content {
        position: relative;
        z-index: 3;
        padding-right: 42px;
        padding-top: 8px;
    }

    .warehouse-kicker,
    .warehouse-section-kicker {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(21, 152, 255, .08);
        color: #1598ff;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin: 0 0 12px;
    }

    .warehouse-hero-title {
        color: #0b1f33;
        font-size: 56px;
        line-height: 1.03;
        font-weight: 900;
        letter-spacing: -.045em;
        margin: 0 0 18px;
        max-width: 820px;
    }

    .warehouse-hero-subtitle {
        color: #4e5d78;
        font-size: 18px;
        line-height: 1.65;
        max-width: 780px;
        margin: 0 0 26px;
    }

    .warehouse-meta-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        max-width: 780px;
        margin: 0 0 28px;
    }

    .warehouse-meta-card {
        display: flex;
        align-items: center;
        gap: 16px;
        min-height: 92px;
        padding: 22px 24px;
        background: #ffffff;
        border: 1px solid #e8edf5;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(16, 54, 92, .045);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .warehouse-meta-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 34px rgba(16, 54, 92, .07);
        }

        .warehouse-meta-card i {
            font-size: 28px;
            color: #ef233c;
            flex-shrink: 0;
        }

        .warehouse-meta-card span {
            font-size: 22px;
            line-height: 1.2;
            font-weight: 850;
            color: #0b1f33;
        }

    .warehouse-intro-text {
        max-width: 840px;
        margin: 0;
    }

        .warehouse-intro-text p {
            color: #4e5d78;
            font-size: 17px;
            line-height: 1.85;
            margin-bottom: 16px;
        }

            .warehouse-intro-text p:last-child {
                margin-bottom: 0;
            }

    .warehouse-hero-visual {
        position: relative;
        z-index: 1;
        width: 100%;
        height: clamp(620px, 72vw, 820px);
        pointer-events: none;
        overflow: hidden;
        margin-top: -14px;
    }

        .warehouse-hero-visual::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 2;
            pointer-events: none;
            background: linear-gradient( to right, rgba(255,255,255,.98) 0%, rgba(255,255,255,.90) 10%, rgba(255,255,255,.74) 20%, rgba(255,255,255,.46) 32%, rgba(255,255,255,.16) 44%, rgba(255,255,255,0) 58% ), linear-gradient( to bottom, rgba(255,255,255,0) 82%, rgba(255,255,255,.28) 92%, rgba(255,255,255,.82) 100% );
        }

        .warehouse-hero-visual img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center right;
            display: block;
            filter: saturate(1.02) contrast(1.01);
        }

    /* ===== INSIGHT ===== */

    .warehouse-insight-box {
        margin: 26px 0 40px;
        padding: 26px 30px;
        background: #ffffff;
        border: 1px solid #eef2f7;
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(16,54,92,.05), 0 2px 10px rgba(16,54,92,.03);
        display: flex;
        align-items: stretch;
        gap: 24px;
    }

    .warehouse-insight-line {
        width: 4px;
        border-radius: 10px;
        background: linear-gradient(180deg, #1598ff 0%, #ef233c 100%);
        flex-shrink: 0;
    }

    .warehouse-insight-content {
        display: flex;
        align-items: flex-start;
        gap: 18px;
    }

        .warehouse-insight-content i {
            font-size: 30px;
            color: #1598ff;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .warehouse-insight-content p {
            margin: 0;
            color: #26384f;
            font-size: 24px;
            line-height: 1.55;
            font-weight: 700;
        }

    /* ===== COMMON SECTIONS ===== */

    .warehouse-modules-section,
    .warehouse-platform-section {
        margin: 44px 0;
    }

    .warehouse-section-title {
        color: #0b1f33;
        font-size: 42px;
        line-height: 1.12;
        font-weight: 900;
        letter-spacing: -.03em;
        margin: 0 0 16px;
    }

    .warehouse-section-lead {
        color: #4e5d78;
        font-size: 18px;
        line-height: 1.75;
        max-width: 960px;
        margin-bottom: 28px;
    }

    /* ===== MODULE CARDS ===== */

    .warehouse-modules-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }

    .warehouse-module-card,
    .warehouse-platform-card {
        position: relative;
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(16,54,92,.045), 0 2px 10px rgba(16,54,92,.025);
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }

        .warehouse-module-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            height: 4px;
            width: 100%;
            background: #ef233c;
        }

        .warehouse-module-card:hover,
        .warehouse-platform-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 22px 50px rgba(16,54,92,.08), 0 8px 18px rgba(16,54,92,.04);
        }

    .warehouse-module-head {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 22px;
    }

    .warehouse-module-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: rgba(239,35,60,.07);
        color: #ef233c;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .warehouse-module-icon i {
            font-size: 28px;
        }

    .warehouse-module-card h3,
    .warehouse-platform-card h3 {
        color: #0b1f33;
        font-size: 24px;
        line-height: 1.22;
        font-weight: 850;
        margin: 3px 0 14px;
    }

    .warehouse-module-card ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .warehouse-module-card li {
        position: relative;
        padding-left: 28px;
        color: #4e5d78;
        font-size: 15.5px;
        line-height: 1.65;
        margin-bottom: 11px;
    }

        .warehouse-module-card li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: #ef233c;
            font-weight: 900;
        }

    /* ===== PLATFORM SECTION ===== */

    .warehouse-platform-grid {
        display: grid;
        grid-template-columns: 1fr 360px 1fr;
        gap: 28px;
        align-items: center;
        margin-top: 32px;
    }

    .warehouse-platform-column {
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

    .warehouse-platform-card i {
        color: #ef233c;
        font-size: 34px;
        margin-bottom: 14px;
        display: block;
    }

    .warehouse-platform-card p {
        color: #4e5d78;
        line-height: 1.65;
        margin: 0;
    }

    .warehouse-platform-core {
        display: flex;
        justify-content: center;
    }

    .warehouse-platform-ring {
        width: 340px;
        height: 340px;
        border-radius: 50%;
        border: 2px solid rgba(21,152,255,.35);
        background: radial-gradient(circle at center, rgba(21,152,255,.12), rgba(21,152,255,.04), transparent 70%);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

        .warehouse-platform-ring i {
            font-size: 42px;
            color: #1598ff;
            margin-bottom: 14px;
        }

        .warehouse-platform-ring h3 {
            color: #0b1f33;
            font-size: 34px;
            font-weight: 900;
            margin-bottom: 10px;
        }

        .warehouse-platform-ring p {
            color: #4e5d78;
            line-height: 1.55;
            margin: 0;
        }

    /* ===== WIDE VISUAL ===== */

    .warehouse-visual-section {
        margin: 38px 0 34px;
    }

        .warehouse-visual-section img {
            width: 100%;
            display: block;
            border-radius: 22px;
            box-shadow: 0 16px 42px rgba(16,54,92,.08), 0 4px 12px rgba(16,54,92,.04);
        }

    /* ===== IMPACT ===== */

    .warehouse-impact-box {
        margin: 36px 0;
        padding: 34px;
        background: #071b3a;
        border-radius: 22px;
        color: #ffffff;
    }

    .warehouse-impact-title {
        text-align: center;
        font-size: 32px;
        line-height: 1.25;
        font-weight: 900;
        margin-bottom: 28px;
    }

    .warehouse-impact-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 22px;
    }

        .warehouse-impact-grid div {
            text-align: center;
            padding: 0 12px;
        }

        .warehouse-impact-grid i {
            color: #1598ff;
            font-size: 34px;
            margin-bottom: 12px;
            display: block;
        }

        .warehouse-impact-grid strong {
            display: block;
            font-size: 20px;
            line-height: 1.3;
            margin-bottom: 8px;
        }

        .warehouse-impact-grid span {
            display: block;
            color: rgba(255,255,255,.72);
            line-height: 1.5;
        }

    /* ===== META BOTTOM ===== */

    .warehouse-page .meta-bottom {
        margin-top: 38px;
        padding-top: 22px;
        border-top: 1px solid #eef2f7;
    }

    /* ===== RESPONSIVE ===== */

    @@media (max-width: 1200px) {
        .warehouse-hero-section,
        .warehouse-platform-grid {
            grid-template-columns: 1fr;
        }

        .warehouse-hero-content {
            padding-right: 0;
        }

        .warehouse-hero-visual {
            height: 520px;
            margin-top: 18px;
        }

        .warehouse-modules-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .warehouse-platform-ring {
            width: 300px;
            height: 300px;
        }
    }

    @@media (max-width: 768px) {
        .warehouse-hero-title {
            font-size: 38px;
        }

        .warehouse-section-title {
            font-size: 34px;
        }

        .warehouse-meta-grid,
        .warehouse-modules-grid,
        .warehouse-impact-grid {
            grid-template-columns: 1fr;
        }

        .warehouse-meta-card span {
            font-size: 20px;
        }

        .warehouse-insight-content p {
            font-size: 18px;
        }

        .warehouse-hero-visual {
            height: 420px;
        }
    }
</style>

    <main class="main">
        <div class="page-title light-background">
            <div class="container d-lg-flex justify-content-between align-items-center">
