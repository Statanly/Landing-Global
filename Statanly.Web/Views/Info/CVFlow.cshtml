                            ●<span style='font:7.0pt "Times New Roman"'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>
                        </span><span lang=EN style='font-size:14.0pt;line-height:115%;font-family:"Times New Roman",serif'>handler</span><span lang=RU style='font-size:14.0pt;line-height:115%;font-family:"Times New Roman",serif'>
