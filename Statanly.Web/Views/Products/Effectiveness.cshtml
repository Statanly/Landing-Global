@{ ViewData["Title"] = "Human Behavior & Event Analytics"; }

<header class="header d-flex align-items-center sticky-top" id="header">
    <div class="container-fluid container-xl position-relative d-flex align-items-center">
        <a class="logo d-flex align-items-center me-auto" href="/">
            <img alt="" src="~/Logo3.png" />
        </a>

        <nav class="navmenu" id="navmenu">
            <ul>
                <li><a data-i18n="nav.home" href="/">Home</a></li>
                <li><a data-i18n="nav.platform" href="#about">Platform</a></li>
                <li><a data-i18n="nav.services" href="/services">Services</a></li>
                <li><a class="active" data-i18n="nav.products" href="/products">Products</a></li>
                <li><a data-i18n="nav.contacts" href="#contact">Contacts</a></li>
            </ul>
            <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
        </nav>

        <div class="language-flags dropdown">
            <button aria-expanded="false" class="lang-current dropdown-toggle" data-bs-toggle="dropdown" id="languageDropdown" type="button">
                <span class="fi fi-gb lang-flag"></span>
                <span class="lang-code">EN</span>
            </button>
            <ul aria-labelledby="languageDropdown" class="dropdown-menu dropdown-menu-end">
                <li><button class="dropdown-item lang-option" data-lang="en" type="button"><span class="fi fi-gb"></span> English</button></li>
                <li><button class="dropdown-item lang-option" data-lang="es" type="button"><span class="fi fi-es"></span> Español</button></li>
                <li><button class="dropdown-item lang-option" data-lang="pt" type="button"><span class="fi fi-pt"></span> Português</button></li>
                <li><button class="dropdown-item lang-option" data-lang="it" type="button"><span class="fi fi-it"></span> Italiano</button></li>
                <li><button class="dropdown-item lang-option" data-lang="fr" type="button"><span class="fi fi-fr"></span> Français</button></li>
                <li><button class="dropdown-item lang-option" data-lang="de" type="button"><span class="fi fi-de"></span> Deutsch</button></li>
                <li><button class="dropdown-item lang-option" data-lang="ru" type="button"><span class="fi fi-ru"></span> Русский</button></li>
            </ul>
        </div>

        <a class="btn-getstarted" data-i18n="common.getStarted" href="#contact">Get Started</a>
    </div>
</header>

<style>
    /* =========================================================
       HUMAN BEHAVIOR & EVENT ANALYTICS PRODUCT PAGE
       Product-focused template: article frame, white background,
       navy typography, brand blue accents, brand red icons.
    ========================================================= */

    .behavior-product-page {
        background: #ffffff;
        color: #172b4d;
    }

        .behavior-product-page * {
            box-sizing: border-box;
        }

    /* ===== HERO ===== */

    .behavior-hero-section {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 47%;
        gap: 34px;
        align-items: stretch;
        margin: 0 0 32px;
        padding: 0;
        overflow: hidden;
        background: #ffffff;
    }

    .behavior-hero-content {
        position: relative;
        z-index: 3;
        padding-right: 42px;
        padding-top: 8px;
    }

    .behavior-kicker,
    .behavior-section-kicker {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(21, 152, 255, .08);
        color: #1598ff;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin: 0 0 12px;
    }

    .behavior-hero-title {
        color: #0b1f33;
        font-size: 56px;
        line-height: 1.03;
        font-weight: 900;
        letter-spacing: -.045em;
        margin: 0 0 18px;
        max-width: 880px;
    }

    .behavior-hero-subtitle {
        color: #4e5d78;
        font-size: 18px;
        line-height: 1.65;
        max-width: 800px;
        margin: 0 0 26px;
    }

    .behavior-hero-bullets {
        list-style: none;
        padding: 0;
        margin: 0 0 28px;
        display: grid;
        gap: 13px;
        max-width: 780px;
    }

        .behavior-hero-bullets li {
            position: relative;
            padding-left: 32px;
            color: #334155;
            font-size: 17px;
            line-height: 1.55;
            font-weight: 650;
        }

            .behavior-hero-bullets li::before {
                content: "✓";
                position: absolute;
                left: 0;
                top: 0;
                color: #ef233c;
                font-weight: 900;
            }

    .behavior-meta-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        max-width: 880px;
        margin: 0 0 26px;
    }

    .behavior-meta-card {
        min-height: 112px;
        padding: 18px 16px;
        background: #ffffff;
        border: 1px solid #e8edf5;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(16, 54, 92, .045);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .behavior-meta-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 34px rgba(16, 54, 92, .07);
        }

        .behavior-meta-card i {
            display: block;
            color: #ef233c;
            font-size: 28px;
            margin-bottom: 12px;
        }

        .behavior-meta-card strong {
            display: block;
            color: #0b1f33;
            font-size: 23px;
            line-height: 1.1;
            font-weight: 900;
            margin-bottom: 6px;
        }

        .behavior-meta-card span {
            display: block;
            color: #4e5d78;
            font-size: 13px;
            line-height: 1.45;
            font-weight: 650;
        }

    .behavior-hero-visual {
        position: relative;
        z-index: 1;
        width: 100%;
        height: clamp(620px, 70vw, 860px);
        pointer-events: none;
        overflow: hidden;
        margin-top: -14px;
    }

        .behavior-hero-visual::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 2;
            pointer-events: none;
            background: linear-gradient( to right, rgba(255,255,255,.98) 0%, rgba(255,255,255,.92) 10%, rgba(255,255,255,.76) 20%, rgba(255,255,255,.48) 32%, rgba(255,255,255,.16) 44%, rgba(255,255,255,0) 58% ), linear-gradient( to bottom, rgba(255,255,255,0) 83%, rgba(255,255,255,.28) 92%, rgba(255,255,255,.82) 100% );
        }

        .behavior-hero-visual img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            display: block;
            filter: saturate(1.02) contrast(1.02);
        }

    /* ===== STRIP ===== */

    .behavior-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        margin: 22px 0 40px;
        border: 1px solid #eef2f7;
        border-radius: 18px;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(16,54,92,.045), 0 2px 10px rgba(16,54,92,.025);
    }

    .behavior-strip-item {
        padding: 24px 22px;
        border-right: 1px solid #eef2f7;
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }

        .behavior-strip-item:last-child {
            border-right: 0;
        }

        .behavior-strip-item i {
            font-size: 30px;
            color: #ef233c;
            flex-shrink: 0;
        }

        .behavior-strip-item strong {
            display: block;
            color: #0b1f33;
            font-size: 18px;
            line-height: 1.25;
            font-weight: 850;
            margin-bottom: 6px;
        }

        .behavior-strip-item span {
            display: block;
            color: #4e5d78;
            font-size: 14px;
            line-height: 1.5;
        }

    /* ===== COMMON SECTIONS ===== */

    .behavior-section {
        margin: 44px 0;
    }

    .behavior-section-title {
        color: #0b1f33;
        font-size: 42px;
        line-height: 1.12;
        font-weight: 900;
        letter-spacing: -.03em;
        margin: 0 0 16px;
    }

    .behavior-section-lead {
        color: #4e5d78;
        font-size: 18px;
        line-height: 1.75;
        max-width: 980px;
        margin-bottom: 28px;
    }

    /* ===== CAPABILITIES ===== */

    .behavior-capabilities-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 14px;
    }

    .behavior-capability-card {
        min-height: 172px;
        padding: 22px 20px;
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(16,54,92,.035);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .behavior-capability-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 40px rgba(16,54,92,.08);
        }

        .behavior-capability-card i {
            display: block;
            color: #ef233c;
            font-size: 30px;
            margin-bottom: 14px;
        }

        .behavior-capability-card h3 {
            color: #0b1f33;
            font-size: 17px;
            line-height: 1.25;
            font-weight: 850;
            margin: 0 0 9px;
        }

        .behavior-capability-card p {
            color: #4e5d78;
            font-size: 13.5px;
            line-height: 1.55;
            margin: 0;
        }

    /* ===== DASHBOARD ===== */

    .behavior-dashboard-grid {
        display: grid;
        grid-template-columns: 360px minmax(0, 1fr);
        gap: 32px;
        align-items: center;
    }

    .behavior-dashboard-text h2 {
        color: #0b1f33;
        font-size: 34px;
        line-height: 1.18;
        font-weight: 900;
        margin: 0 0 16px;
    }

    .behavior-dashboard-text p {
        color: #4e5d78;
        font-size: 17px;
        line-height: 1.75;
        margin: 0 0 20px;
    }

    .behavior-check-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .behavior-check-list li {
            position: relative;
            color: #4e5d78;
            font-size: 16px;
            line-height: 1.65;
            padding-left: 30px;
            margin-bottom: 12px;
        }

            .behavior-check-list li::before {
                content: "✓";
                position: absolute;
                left: 0;
                color: #ef233c;
                font-weight: 900;
            }

    .behavior-dashboard-image {
        background: #071b3a;
        border: 1px solid #142d50;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 18px 46px rgba(7,27,58,.20);
    }

        .behavior-dashboard-image img {
            width: 100%;
            display: block;
        }

    /* ===== USE CASES ===== */

    .behavior-usecase-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    .behavior-usecase-card {
        position: relative;
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 20px;
        padding: 26px;
        box-shadow: 0 10px 30px rgba(16,54,92,.04);
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .behavior-usecase-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 40px rgba(16,54,92,.08);
        }

        .behavior-usecase-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            height: 4px;
            width: 100%;
            background: #ef233c;
        }

        .behavior-usecase-card i {
            color: #ef233c;
            font-size: 34px;
            display: block;
            margin-bottom: 16px;
        }

        .behavior-usecase-card h3 {
            color: #0b1f33;
            font-size: 23px;
            line-height: 1.22;
            font-weight: 850;
            margin: 0 0 14px;
        }

        .behavior-usecase-card p {
            color: #4e5d78;
            line-height: 1.65;
            margin: 0;
        }

    /* ===== PLATFORM ===== */

    .behavior-platform-grid {
        display: grid;
        grid-template-columns: 1fr 340px 1fr;
        gap: 28px;
        align-items: center;
        margin-top: 32px;
    }

    .behavior-platform-column {
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

    .behavior-platform-card {
        position: relative;
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 10px 30px rgba(16,54,92,.045), 0 2px 10px rgba(16,54,92,.025);
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .behavior-platform-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 22px 50px rgba(16,54,92,.08), 0 8px 18px rgba(16,54,92,.04);
        }

        .behavior-platform-card i {
            color: #ef233c;
            font-size: 34px;
            margin-bottom: 14px;
            display: block;
        }

        .behavior-platform-card h3 {
            color: #0b1f33;
            font-size: 23px;
            line-height: 1.22;
            font-weight: 850;
            margin: 0 0 12px;
        }

        .behavior-platform-card p,
        .behavior-platform-card li {
            color: #4e5d78;
            line-height: 1.65;
            margin: 0;
        }

        .behavior-platform-card ul {
            margin: 0;
            padding-left: 18px;
        }

    .behavior-platform-core {
        display: flex;
        justify-content: center;
    }

    .behavior-platform-ring {
        width: 320px;
        height: 320px;
        border-radius: 50%;
        border: 2px solid rgba(21,152,255,.35);
        background: radial-gradient(circle at center, rgba(21,152,255,.12), rgba(21,152,255,.04), transparent 70%);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

        .behavior-platform-ring i {
            font-size: 42px;
            color: #1598ff;
            margin-bottom: 14px;
        }

        .behavior-platform-ring h3 {
            color: #0b1f33;
            font-size: 32px;
            font-weight: 900;
            margin-bottom: 10px;
        }

        .behavior-platform-ring p {
            color: #4e5d78;
            line-height: 1.55;
            margin: 0;
        }

    /* ===== IMPACT ===== */

    .behavior-impact-box {
        margin: 40px 0 0;
        padding: 28px 30px;
        background: #ffffff;
        border: 1px solid #eef2f7;
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(16,54,92,.05), 0 2px 10px rgba(16,54,92,.03);
        display: flex;
        align-items: stretch;
        gap: 24px;
    }

    .behavior-impact-line {
        width: 4px;
        border-radius: 10px;
        background: linear-gradient(180deg, #1598ff 0%, #ef233c 100%);
        flex-shrink: 0;
    }

    .behavior-impact-content {
        display: flex;
        align-items: flex-start;
        gap: 18px;
    }

        .behavior-impact-content i {
            font-size: 30px;
            color: #1598ff;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .behavior-impact-content p {
            margin: 0;
            color: #26384f;
            font-size: 24px;
            line-height: 1.55;
            font-weight: 700;
        }

    .behavior-product-page .meta-bottom {
        margin-top: 38px;
        padding-top: 22px;
        border-top: 1px solid #eef2f7;
    }

    /* ===== RESPONSIVE ===== */

    @@media (max-width: 1200px) {
        .behavior-hero-section,
        .behavior-dashboard-grid,
        .behavior-platform-grid {
            grid-template-columns: 1fr;
        }

        .behavior-hero-content {
            padding-right: 0;
        }

        .behavior-hero-visual {
            height: 520px;
            margin-top: 18px;
        }

        .behavior-capabilities-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .behavior-usecase-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .behavior-meta-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .behavior-strip {
            grid-template-columns: repeat(2, 1fr);
        }

        .behavior-strip-item:nth-child(2) {
            border-right: 0;
        }

        .behavior-strip-item:nth-child(1),
        .behavior-strip-item:nth-child(2) {
            border-bottom: 1px solid #eef2f7;
        }
    }

    @@media (max-width: 768px) {
        .behavior-hero-title {
            font-size: 38px;
        }

        .behavior-section-title {
            font-size: 34px;
        }

        .behavior-meta-grid,
        .behavior-strip,
        .behavior-capabilities-grid,
        .behavior-usecase-grid {
            grid-template-columns: 1fr;
        }

        .behavior-strip-item {
            border-right: 0 !important;
            border-bottom: 1px solid #eef2f7;
        }

            .behavior-strip-item:last-child {
                border-bottom: 0;
            }

        .behavior-hero-visual {
            height: 420px;
        }

        .behavior-impact-content p {
            font-size: 18px;
        }
    }
</style>

<main class="main">
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Human Behavior & Event Analytics</h1>

            <nav class="breadcrumbs">
                <ol>
                    <li><a href="/">Home</a></li>
                    <li><a href="/home/products">Products</a></li>
                    <li class="current">Human Behavior & Event Analytics</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="container">
        <section class="blog-details section" id="blog-details">
            <div class="container">
                <article class="article">
                    <div class="behavior-product-page">

                        <section class="behavior-hero-section">
                            <div class="behavior-hero-content">
                                <div class="behavior-kicker">Product</div>

                                <h1 class="behavior-hero-title">
                                    Human Behavior & Event Analytics
                                </h1>

                                <p class="behavior-hero-subtitle">
                                    AI-powered analytics for people, behavior, attendance, task execution and operational events to improve efficiency, safety and business transparency.
                                </p>

                                <ul class="behavior-hero-bullets">
                                    <li>Employee engagement monitoring</li>
                                    <li>Task performance and staff action analysis</li>
                                    <li>Theft and suspicious event detection</li>
                                </ul>

                                <div class="behavior-meta-grid">
                                    <div class="behavior-meta-card">
                                        <i class="bi bi-people"></i>
                                        <strong>People</strong>
                                        <span>Counting, occupancy and flow analytics</span>
                                    </div>

                                    <div class="behavior-meta-card">
                                        <i class="bi bi-heart-pulse"></i>
                                        <strong>Engagement</strong>
                                        <span>Activity, involvement and behavior signals</span>
                                    </div>

                                    <div class="behavior-meta-card">
                                        <i class="bi bi-clock-history"></i>
                                        <strong>Attendance</strong>
                                        <span>Arrival, departure and punctuality analytics</span>
                                    </div>

                                    <div class="behavior-meta-card">
                                        <i class="bi bi-bell"></i>
                                        <strong>Events</strong>
                                        <span>Real-time alerts and incident history</span>
                                    </div>
                                </div>
                            </div>

                            <div class="behavior-hero-visual">
                                <img src="~/assets/img/products/Effectiveness/human-behavior-hero.png" alt="Human behavior and event analytics AI product">
                            </div>
                        </section>

                        <div class="behavior-strip">
                            <div class="behavior-strip-item">
                                <i class="bi bi-camera-video"></i>
                                <div>
                                    <strong>Existing Cameras</strong>
                                    <span>Connect CCTV, VMS, RTSP and ONVIF streams without replacing infrastructure.</span>
                                </div>
                            </div>

                            <div class="behavior-strip-item">
                                <i class="bi bi-diagram-3"></i>
                                <div>
                                    <strong>Scenario Engine</strong>
                                    <span>Combine people analytics, zones, schedules, events and business rules.</span>
                                </div>
                            </div>

                            <div class="behavior-strip-item">
                                <i class="bi bi-bar-chart-line"></i>
                                <div>
                                    <strong>BI & Reports</strong>
                                    <span>Dashboards, KPIs, staff metrics, attendance and event analytics.</span>
                                </div>
                            </div>

                            <div class="behavior-strip-item">
                                <i class="bi bi-plug"></i>
                                <div>
                                    <strong>Enterprise Integrations</strong>
                                    <span>VMS, ERP, HR, BI, Access Control, Active Directory and API.</span>
                                </div>
                            </div>
                        </div>

                        <section class="behavior-section">
                            <div class="behavior-section-kicker">Key capabilities</div>

                            <h2 class="behavior-section-title">
                                AI Capabilities for People, Behavior and Events
                            </h2>

                            <p class="behavior-section-lead">
                                The product transforms video streams into objective operational data about people flow, employee actions, attendance, engagement, suspicious behavior and business process quality.
                            </p>

                            <div class="behavior-capabilities-grid">
                                <div class="behavior-capability-card">
                                    <i class="bi bi-person-bounding-box"></i>
                                    <h3>People Counting</h3>
                                    <p>Accurate people counting, occupancy analytics and visitor or employee flow monitoring.</p>
                                </div>

                                <div class="behavior-capability-card">
                                    <i class="bi bi-heart-pulse"></i>
                                    <h3>Engagement Monitoring</h3>
                                    <p>Activity, involvement, presence, interaction intensity and behavioral signals.</p>
                                </div>

                                <div class="behavior-capability-card">
                                    <i class="bi bi-clock"></i>
                                    <h3>Time & Attendance</h3>
                                    <p>Arrival, departure, punctuality, discipline and attendance analytics by zone.</p>
                                </div>

                                <div class="behavior-capability-card">
                                    <i class="bi bi-clipboard-check"></i>
                                    <h3>Task & Workflow Analysis</h3>
                                    <p>Control of staff actions, task stages, work execution and process compliance.</p>
                                </div>

                                <div class="behavior-capability-card">
                                    <i class="bi bi-lock"></i>
                                    <h3>Theft & Suspicious Events</h3>
                                    <p>Detection of theft risks, suspicious activity, loitering and policy violations.</p>
                                </div>

                                <div class="behavior-capability-card">
                                    <i class="bi bi-bell"></i>
                                    <h3>Alerts & Events</h3>
                                    <p>Real-time alerts for incidents, violations, abnormal behavior and operational events.</p>
                                </div>
                            </div>
                        </section>

                        <section class="behavior-section">
                            <div class="behavior-dashboard-grid">
                                <div class="behavior-dashboard-text">
                                    <div class="behavior-section-kicker">Real-time analytics</div>

                                    <h2>Human Behavior Analytics Dashboard</h2>

                                    <p>
                                        The dashboard provides a single view of people count, engagement, on-time metrics, incidents, trends and event history for managers and operational teams.
                                    </p>

                                    <ul class="behavior-check-list">
                                        <li>Real-time monitoring of people, zones and activity</li>
                                        <li>Behavior and engagement analytics</li>
                                        <li>Trend visualization and operational KPIs</li>
                                        <li>Custom reports by location, team or shift</li>
                                        <li>Multi-location management and event archive</li>
                                    </ul>
                                </div>

                                <div class="behavior-dashboard-image">
                                    <img src="~/assets/img/products/Effectiveness/human-behavior-dashboard.png" alt="Human behavior analytics dashboard">
                                </div>
                            </div>
                        </section>

