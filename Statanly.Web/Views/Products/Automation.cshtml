@{ ViewData["Title"] = "Production Line Automation"; }

<header class="header d-flex align-items-center sticky-top" id="header">
    <div class="container-fluid container-xl position-relative d-flex align-items-center">
        <a class="logo d-flex align-items-center me-auto" href="/">
            <img alt="" src="~/Logo3.png" />
        </a>

        <nav class="navmenu" id="navmenu">
            <ul>
                <li><a data-i18n="nav.home" href="/">Home</a></li>
                <li><a data-i18n="nav.platform" href="#about">Platform</a></li>
                <li><a data-i18n="nav.services" href="/services">Services</a></li>
                <li><a class="active" data-i18n="nav.products" href="/products">Products</a></li>
                <li><a data-i18n="nav.contacts" href="#contact">Contacts</a></li>
            </ul>
            <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
        </nav>

        <div class="language-flags dropdown">
            <button aria-expanded="false" class="lang-current dropdown-toggle" data-bs-toggle="dropdown" id="languageDropdown" type="button">
                <span class="fi fi-gb lang-flag"></span>
                <span class="lang-code">EN</span>
            </button>
            <ul aria-labelledby="languageDropdown" class="dropdown-menu dropdown-menu-end">
                <li><button class="dropdown-item lang-option" data-lang="en" type="button"><span class="fi fi-gb"></span> English</button></li>
                <li><button class="dropdown-item lang-option" data-lang="es" type="button"><span class="fi fi-es"></span> Español</button></li>
                <li><button class="dropdown-item lang-option" data-lang="pt" type="button"><span class="fi fi-pt"></span> Português</button></li>
                <li><button class="dropdown-item lang-option" data-lang="it" type="button"><span class="fi fi-it"></span> Italiano</button></li>
                <li><button class="dropdown-item lang-option" data-lang="fr" type="button"><span class="fi fi-fr"></span> Français</button></li>
                <li><button class="dropdown-item lang-option" data-lang="de" type="button"><span class="fi fi-de"></span> Deutsch</button></li>
                <li><button class="dropdown-item lang-option" data-lang="ru" type="button"><span class="fi fi-ru"></span> Русский</button></li>
            </ul>
        </div>

        <a class="btn-getstarted" data-i18n="common.getStarted" href="#contact">Get Started</a>
    </div>
</header>

<style>
    /* =========================================================
       PRODUCTION LINE AUTOMATION PRODUCT PAGE
       Strict product template: article frame, white background,
       navy typography, blue accents, red product icons.
    ========================================================= */

    .line-product-page {
        background: #ffffff;
        color: #172b4d;
    }

        .line-product-page * {
            box-sizing: border-box;
        }

    /* ===== HERO ===== */

    .line-hero-section {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 47%;
        gap: 34px;
        align-items: stretch;
        margin: 0 0 32px;
        padding: 0;
        overflow: hidden;
        background: #ffffff;
    }

    .line-hero-content {
        position: relative;
        z-index: 3;
        padding-right: 42px;
        padding-top: 8px;
    }

    .line-kicker,
    .line-section-kicker {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(21, 152, 255, .08);
        color: #1598ff;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin: 0 0 12px;
    }

    .line-hero-title {
        color: #0b1f33;
        font-size: 56px;
        line-height: 1.03;
        font-weight: 900;
        letter-spacing: -.045em;
        margin: 0 0 18px;
        max-width: 860px;
    }

    .line-hero-subtitle {
        color: #4e5d78;
        font-size: 18px;
        line-height: 1.65;
        max-width: 800px;
        margin: 0 0 26px;
    }

    .line-hero-bullets {
        list-style: none;
        padding: 0;
        margin: 0 0 28px;
        display: grid;
        gap: 13px;
        max-width: 780px;
    }

        .line-hero-bullets li {
            position: relative;
            padding-left: 32px;
            color: #334155;
            font-size: 17px;
            line-height: 1.55;
            font-weight: 650;
        }

            .line-hero-bullets li::before {
                content: "✓";
                position: absolute;
                left: 0;
                top: 0;
                color: #ef233c;
                font-weight: 900;
            }

    .line-meta-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        max-width: 880px;
        margin: 0 0 26px;
    }

    .line-meta-card {
        min-height: 112px;
        padding: 18px 16px;
        background: #ffffff;
        border: 1px solid #e8edf5;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(16, 54, 92, .045);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .line-meta-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 34px rgba(16, 54, 92, .07);
        }

        .line-meta-card i {
            display: block;
            color: #ef233c;
            font-size: 28px;
            margin-bottom: 12px;
        }

        .line-meta-card strong {
            display: block;
            color: #0b1f33;
            font-size: 23px;
            line-height: 1.1;
            font-weight: 900;
            margin-bottom: 6px;
        }

        .line-meta-card span {
            display: block;
            color: #4e5d78;
            font-size: 13px;
            line-height: 1.45;
            font-weight: 650;
        }

    .line-hero-visual {
        position: relative;
        z-index: 1;
        width: 100%;
        height: clamp(620px, 70vw, 860px);
        pointer-events: none;
        overflow: hidden;
        margin-top: -14px;
    }

        .line-hero-visual::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 2;
            pointer-events: none;
            background: linear-gradient( to right, rgba(255,255,255,.98) 0%, rgba(255,255,255,.92) 10%, rgba(255,255,255,.76) 20%, rgba(255,255,255,.48) 32%, rgba(255,255,255,.16) 44%, rgba(255,255,255,0) 58% ), linear-gradient( to bottom, rgba(255,255,255,0) 83%, rgba(255,255,255,.28) 92%, rgba(255,255,255,.82) 100% );
        }

        .line-hero-visual img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            display: block;
            filter: saturate(1.02) contrast(1.02);
        }

    /* ===== STRIP ===== */

    .line-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        margin: 22px 0 40px;
        border: 1px solid #eef2f7;
        border-radius: 18px;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(16,54,92,.045), 0 2px 10px rgba(16,54,92,.025);
    }

    .line-strip-item {
        padding: 24px 22px;
        border-right: 1px solid #eef2f7;
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }

        .line-strip-item:last-child {
            border-right: 0;
        }

        .line-strip-item i {
            font-size: 30px;
            color: #ef233c;
            flex-shrink: 0;
        }

        .line-strip-item strong {
            display: block;
            color: #0b1f33;
            font-size: 18px;
            line-height: 1.25;
            font-weight: 850;
            margin-bottom: 6px;
        }

        .line-strip-item span {
            display: block;
            color: #4e5d78;
            font-size: 14px;
            line-height: 1.5;
        }

    /* ===== COMMON SECTIONS ===== */

    .line-section {
        margin: 44px 0;
    }

    .line-section-title {
        color: #0b1f33;
        font-size: 42px;
        line-height: 1.12;
        font-weight: 900;
        letter-spacing: -.03em;
        margin: 0 0 16px;
    }

    .line-section-lead {
        color: #4e5d78;
        font-size: 18px;
        line-height: 1.75;
        max-width: 980px;
        margin-bottom: 28px;
    }

    /* ===== CAPABILITIES ===== */

    .line-capabilities-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 14px;
    }

    .line-capability-card {
        min-height: 172px;
        padding: 22px 20px;
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(16,54,92,.035);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .line-capability-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 40px rgba(16,54,92,.08);
        }

        .line-capability-card i {
            display: block;
            color: #ef233c;
            font-size: 30px;
            margin-bottom: 14px;
        }

        .line-capability-card h3 {
            color: #0b1f33;
            font-size: 17px;
            line-height: 1.25;
            font-weight: 850;
            margin: 0 0 9px;
        }

        .line-capability-card p {
            color: #4e5d78;
            font-size: 13.5px;
            line-height: 1.55;
            margin: 0;
        }

    /* ===== ARCHITECTURE + DASHBOARD ===== */

    .line-two-column-grid {
        display: grid;
        grid-template-columns: 1fr 1.1fr;
        gap: 32px;
        align-items: start;
    }

    .line-image-card {
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 16px 42px rgba(16,54,92,.08), 0 4px 12px rgba(16,54,92,.04);
    }

        .line-image-card.dark {
            background: #071b3a;
            border-color: #142d50;
            box-shadow: 0 18px 46px rgba(7,27,58,.20);
        }

        .line-image-card img {
            width: 100%;
            display: block;
        }

    .line-panel-title {
        color: #0b1f33;
        font-size: 28px;
        line-height: 1.18;
        font-weight: 900;
        margin: 0 0 14px;
    }

    .line-panel-lead {
        color: #4e5d78;
        font-size: 16.5px;
        line-height: 1.7;
        margin: 0 0 18px;
    }

    .line-check-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .line-check-list li {
            position: relative;
            color: #4e5d78;
            font-size: 16px;
            line-height: 1.65;
            padding-left: 30px;
            margin-bottom: 12px;
        }

            .line-check-list li::before {
                content: "✓";
                position: absolute;
                left: 0;
                color: #ef233c;
                font-weight: 900;
            }

    /* ===== USE CASES ===== */

    .line-usecase-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 14px;
    }

    .line-usecase-card {
        position: relative;
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 18px;
        padding: 22px 20px;
        box-shadow: 0 10px 30px rgba(16,54,92,.04);
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .line-usecase-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 40px rgba(16,54,92,.08);
        }

        .line-usecase-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            height: 4px;
            width: 100%;
            background: #ef233c;
        }

        .line-usecase-card i {
            color: #ef233c;
            font-size: 30px;
            display: block;
            margin-bottom: 14px;
        }

        .line-usecase-card h3 {
            color: #0b1f33;
            font-size: 17px;
            line-height: 1.25;
            font-weight: 850;
            margin: 0 0 10px;
        }

        .line-usecase-card p {
            color: #4e5d78;
            font-size: 13.5px;
            line-height: 1.55;
            margin: 0;
        }

    /* ===== PLATFORM ===== */

    .line-platform-grid {
        display: grid;
        grid-template-columns: 1fr 340px 1fr;
        gap: 28px;
        align-items: center;
        margin-top: 32px;
    }

    .line-platform-column {
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

    .line-platform-card {
        position: relative;
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 10px 30px rgba(16,54,92,.045), 0 2px 10px rgba(16,54,92,.025);
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .line-platform-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 22px 50px rgba(16,54,92,.08), 0 8px 18px rgba(16,54,92,.04);
        }

        .line-platform-card i {
            color: #ef233c;
            font-size: 34px;
            margin-bottom: 14px;
            display: block;
        }

        .line-platform-card h3 {
            color: #0b1f33;
            font-size: 23px;
            line-height: 1.22;
            font-weight: 850;
            margin: 0 0 12px;
        }

        .line-platform-card p,
        .line-platform-card li {
            color: #4e5d78;
            line-height: 1.65;
            margin: 0;
        }

        .line-platform-card ul {
            margin: 0;
            padding-left: 18px;
        }

    .line-platform-core {
        display: flex;
        justify-content: center;
    }

    .line-platform-ring {
        width: 320px;
        height: 320px;
        border-radius: 50%;
        border: 2px solid rgba(21,152,255,.35);
        background: radial-gradient(circle at center, rgba(21,152,255,.12), rgba(21,152,255,.04), transparent 70%);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

        .line-platform-ring i {
            font-size: 42px;
            color: #1598ff;
            margin-bottom: 14px;
        }

        .line-platform-ring h3 {
            color: #0b1f33;
            font-size: 32px;
            font-weight: 900;
            margin-bottom: 10px;
        }

        .line-platform-ring p {
            color: #4e5d78;
            line-height: 1.55;
            margin: 0;
        }

    /* ===== IMPACT ===== */

    .line-impact-box {
        margin: 40px 0 0;
        padding: 28px 30px;
        background: #ffffff;
        border: 1px solid #eef2f7;
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(16,54,92,.05), 0 2px 10px rgba(16,54,92,.03);
        display: flex;
        align-items: stretch;
        gap: 24px;
    }

    .line-impact-line {
        width: 4px;
        border-radius: 10px;
        background: linear-gradient(180deg, #1598ff 0%, #ef233c 100%);
        flex-shrink: 0;
    }

    .line-impact-content {
        display: flex;
        align-items: flex-start;
        gap: 18px;
    }

        .line-impact-content i {
            font-size: 30px;
            color: #1598ff;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .line-impact-content p {
            margin: 0;
            color: #26384f;
            font-size: 24px;
            line-height: 1.55;
            font-weight: 700;
        }

    .line-product-page .meta-bottom {
        margin-top: 38px;
        padding-top: 22px;
        border-top: 1px solid #eef2f7;
    }

    /* ===== RESPONSIVE ===== */

    @@media (max-width: 1200px) {
        .line-hero-section,
        .line-two-column-grid,
        .line-platform-grid {
            grid-template-columns: 1fr;
        }

        .line-hero-content {
            padding-right: 0;
        }

        .line-hero-visual {
            height: 520px;
            margin-top: 18px;
        }

        .line-capabilities-grid,
        .line-usecase-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .line-meta-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .line-strip {
            grid-template-columns: repeat(2, 1fr);
        }

        .line-strip-item:nth-child(2) {
            border-right: 0;
        }

        .line-strip-item:nth-child(1),
        .line-strip-item:nth-child(2) {
            border-bottom: 1px solid #eef2f7;
        }
    }

    @@media (max-width: 768px) {
        .line-hero-title {
            font-size: 38px;
        }

        .line-section-title {
            font-size: 34px;
        }

        .line-meta-grid,
        .line-strip,
        .line-capabilities-grid,
        .line-usecase-grid {
            grid-template-columns: 1fr;
        }

        .line-strip-item {
            border-right: 0 !important;
            border-bottom: 1px solid #eef2f7;
        }

            .line-strip-item:last-child {
                border-bottom: 0;
            }

        .line-hero-visual {
            height: 420px;
        }

        .line-impact-content p {
            font-size: 18px;
        }
    }
</style>

<main class="main">
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Production Line Automation</h1>

            <nav class="breadcrumbs">
                <ol>
                    <li><a href="/">Home</a></li>
                    <li><a href="/home/products">Products</a></li>
                    <li class="current">Production Line Automation</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="container">
        <section class="blog-details section" id="blog-details">
            <div class="container">
                <article class="article">
                    <div class="line-product-page">

                        <section class="line-hero-section">
                            <div class="line-hero-content">
                                <div class="line-kicker">Product</div>

                                <h1 class="line-hero-title">
                                    Production Line Automation
                                </h1>

                                <p class="line-hero-subtitle">
                                    AI-powered computer vision for automated monitoring of production lines, conveyors, material flow, object counting, anomaly detection and quality control.
                                </p>

                                <ul class="line-hero-bullets">
                                    <li>Counting and classifying objects on conveyors and production lines</li>
                                    <li>Detection of anomalies, foreign bodies and defects in real time</li>
                                    <li>Determination of geometric characteristics, color, size and fraction distribution</li>
                                </ul>

                                <div class="line-meta-grid">
                                    <div class="line-meta-card">
                                        <i class="bi bi-bar-chart"></i>
                                        <strong>99%+</strong>
                                        <span>High accuracy in stable industrial conditions</span>
                                    </div>

                                    <div class="line-meta-card">
                                        <i class="bi bi-camera-video"></i>
                                        <strong>CCTV</strong>
                                        <span>Works with IP cameras and industrial optics</span>
                                    </div>

                                    <div class="line-meta-card">
                                        <i class="bi bi-cpu"></i>
                                        <strong>AI</strong>
                                        <span>Detection, tracking, segmentation and classification</span>
                                    </div>

                                    <div class="line-meta-card">
                                        <i class="bi bi-plug"></i>
                                        <strong>PLC</strong>
                                        <span>Integration with conveyor and process control systems</span>
                                    </div>
                                </div>
                            </div>

                            <div class="line-hero-visual">
                                <img src="~/assets/img/products/Automation/production-line-hero.png" alt="Production line automation AI product">
                            </div>
                        </section>

                        <div class="line-strip">
                            <div class="line-strip-item">
                                <i class="bi bi-camera-video"></i>
                                <div>
                                    <strong>Industrial Cameras</strong>
                                    <span>IP cameras, lighting, protective boxes, global shutter cameras and additional sensors.</span>
                                </div>
                            </div>

                            <div class="line-strip-item">
                                <i class="bi bi-bounding-box"></i>
                                <div>
                                    <strong>Detector & Tracker</strong>
                                    <span>AI models recognize objects, defects, impurities, product types and track movement.</span>
                                </div>
                            </div>

                            <div class="line-strip-item">
                                <i class="bi bi-sliders"></i>
                                <div>
                                    <strong>Configurable Zones</strong>
                                    <span>Counting lines, areas, object tracking and dwell-time analysis configured in UI.</span>
                                </div>
                            </div>

                            <div class="line-strip-item">
                                <i class="bi bi-plug"></i>
                                <div>
                                    <strong>Conveyor Integration</strong>
                                    <span>Modbus, PLC / SCADA, MES / ERP and low-level industrial integrations.</span>
                                </div>
                            </div>
                        </div>

                        <section class="line-section">
                            <div class="line-section-kicker">Key capabilities</div>

                            <h2 class="line-section-title">
                                Computer Vision Modules for Production Lines
                            </h2>

                            <p class="line-section-lead">
                                The system automates manual inspection, reduces dependence on human labor, detects production deviations and helps prevent conveyor failures, defects and unplanned downtime.
                            </p>

                            <div class="line-capabilities-grid">
                                <div class="line-capability-card">
                                    <i class="bi bi-bar-chart"></i>
                                    <h3>Object Counting</h3>
                                    <p>Automatic counting of products, items, boxes, parts or material flow on the production line.</p>
                                </div>

                                <div class="line-capability-card">
                                    <i class="bi bi-share"></i>
                                    <h3>Classification</h3>
                                    <p>Automatic classification by type, color, shape, size and other product attributes.</p>
                                </div>

                                <div class="line-capability-card">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    <h3>Anomaly Detection</h3>
                                    <p>Detection of abnormal objects, foreign bodies, impurities and conveyor process deviations.</p>
                                </div>

                                <div class="line-capability-card">
                                    <i class="bi bi-rulers"></i>
                                    <h3>Measurement</h3>
                                    <p>Determination of size, length, diameter, shape and other geometric parameters.</p>
                                </div>

                                <div class="line-capability-card">
                                    <i class="bi bi-pie-chart"></i>
                                    <h3>Fraction Analysis</h3>
                                    <p>Real-time analysis of material size distribution and granulometric composition.</p>
                                </div>

                                <div class="line-capability-card">
                                    <i class="bi bi-graph-up-arrow"></i>
                                    <h3>Real-time Analytics</h3>
                                    <p>Dashboards, reports, quality metrics and operational KPIs for data-driven decisions.</p>
                                </div>
                            </div>
                        </section>

                        <section class="line-section">
                            <div class="line-two-column-grid">
                                <div>
                                    <div class="line-section-kicker">Architecture</div>
                                    <h2 class="line-panel-title">Platform Architecture</h2>
                                    <p class="line-panel-lead">
                                        The product connects cameras, sensors, scales, PLC / SCADA, IoT devices and MES / ERP systems into one AI platform for real-time analytics, event scenarios, dashboards and integrations.
                                    </p>

                                    <div class="line-image-card">
                                        <img src="~/assets/img/products/Automation/production-line-architecture.png" alt="Production line automation architecture">
                                    </div>
                                </div>

                                <div>
