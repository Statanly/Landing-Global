@{ ViewData["Title"] = "Industrial Safety & Violation Control"; }

<header class="header d-flex align-items-center sticky-top" id="header">
    <div class="container-fluid container-xl position-relative d-flex align-items-center">
        <a class="logo d-flex align-items-center me-auto" href="/">
            <img alt="" src="~/Logo3.png" />
        </a>

        <nav class="navmenu" id="navmenu">
            <ul>
                <li><a data-i18n="nav.home" href="/">Home</a></li>
                <li><a data-i18n="nav.platform" href="#about">Platform</a></li>
                <li><a data-i18n="nav.services" href="/services">Services</a></li>
                <li><a class="active" data-i18n="nav.products" href="/products">Products</a></li>
                <li><a data-i18n="nav.contacts" href="#contact">Contacts</a></li>
            </ul>
            <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
        </nav>

        <div class="language-flags dropdown">
            <button aria-expanded="false" class="lang-current dropdown-toggle" data-bs-toggle="dropdown" id="languageDropdown" type="button">
                <span class="fi fi-gb lang-flag"></span>
                <span class="lang-code">EN</span>
            </button>
            <ul aria-labelledby="languageDropdown" class="dropdown-menu dropdown-menu-end">
                <li><button class="dropdown-item lang-option" data-lang="en" type="button"><span class="fi fi-gb"></span> English</button></li>
                <li><button class="dropdown-item lang-option" data-lang="es" type="button"><span class="fi fi-es"></span> Español</button></li>
                <li><button class="dropdown-item lang-option" data-lang="pt" type="button"><span class="fi fi-pt"></span> Português</button></li>
                <li><button class="dropdown-item lang-option" data-lang="it" type="button"><span class="fi fi-it"></span> Italiano</button></li>
                <li><button class="dropdown-item lang-option" data-lang="fr" type="button"><span class="fi fi-fr"></span> Français</button></li>
                <li><button class="dropdown-item lang-option" data-lang="de" type="button"><span class="fi fi-de"></span> Deutsch</button></li>
                <li><button class="dropdown-item lang-option" data-lang="ru" type="button"><span class="fi fi-ru"></span> Русский</button></li>
            </ul>
        </div>

        <a class="btn-getstarted" data-i18n="common.getStarted" href="#contact">Get Started</a>
    </div>
</header>

<style>
    /* =========================================================
       INDUSTRIAL SAFETY PRODUCT PAGE
       Product-focused page. Strict template style:
       white article card, navy typography, brand blue accents,
       brand red product icons and alerts.
    ========================================================= */

    .industrial-product-page {
        background: #ffffff;
        color: #172b4d;
    }

        .industrial-product-page * {
            box-sizing: border-box;
        }

    /* ===== HERO ===== */

    .product-hero-section {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 47%;
        gap: 34px;
        align-items: stretch;
        margin: 0 0 32px;
        padding: 0;
        overflow: hidden;
        background: #ffffff;
    }

    .product-hero-content {
        position: relative;
        z-index: 3;
        padding-right: 42px;
        padding-top: 8px;
    }

    .product-kicker,
    .product-section-kicker {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(21, 152, 255, .08);
        color: #1598ff;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin: 0 0 12px;
    }

    .product-hero-title {
        color: #0b1f33;
        font-size: 56px;
        line-height: 1.03;
        font-weight: 900;
        letter-spacing: -.045em;
        margin: 0 0 18px;
        max-width: 860px;
    }

    .product-hero-subtitle {
        color: #4e5d78;
        font-size: 18px;
        line-height: 1.65;
        max-width: 800px;
        margin: 0 0 26px;
    }

    .product-hero-bullets {
        list-style: none;
        padding: 0;
        margin: 0 0 28px;
        display: grid;
        gap: 13px;
        max-width: 780px;
    }

        .product-hero-bullets li {
            position: relative;
            padding-left: 32px;
            color: #334155;
            font-size: 17px;
            line-height: 1.55;
            font-weight: 650;
        }

            .product-hero-bullets li::before {
                content: "✓";
                position: absolute;
                left: 0;
                top: 0;
                color: #ef233c;
                font-weight: 900;
            }

    .product-meta-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        max-width: 880px;
        margin: 0 0 26px;
    }

    .product-meta-card {
        min-height: 112px;
        padding: 18px 16px;
        background: #ffffff;
        border: 1px solid #e8edf5;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(16, 54, 92, .045);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .product-meta-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 34px rgba(16, 54, 92, .07);
        }

        .product-meta-card i {
            display: block;
            color: #ef233c;
            font-size: 28px;
            margin-bottom: 12px;
        }

        .product-meta-card strong {
            display: block;
            color: #0b1f33;
            font-size: 23px;
            line-height: 1.1;
            font-weight: 900;
            margin-bottom: 6px;
        }

        .product-meta-card span {
            display: block;
            color: #4e5d78;
            font-size: 13px;
            line-height: 1.45;
            font-weight: 650;
        }

    .product-hero-visual {
        position: relative;
        z-index: 1;
        width: 100%;
        height: clamp(620px, 70vw, 860px);
        pointer-events: none;
        overflow: hidden;
        margin-top: -14px;
    }

        .product-hero-visual::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 2;
            pointer-events: none;
            background: linear-gradient( to right, rgba(255,255,255,.98) 0%, rgba(255,255,255,.92) 10%, rgba(255,255,255,.76) 20%, rgba(255,255,255,.48) 32%, rgba(255,255,255,.16) 44%, rgba(255,255,255,0) 58% ), linear-gradient( to bottom, rgba(255,255,255,0) 83%, rgba(255,255,255,.28) 92%, rgba(255,255,255,.82) 100% );
        }

        .product-hero-visual img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            display: block;
            filter: saturate(1.02) contrast(1.02);
        }

    /* ===== PRODUCT STRIP ===== */

    .product-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        margin: 22px 0 40px;
        border: 1px solid #eef2f7;
        border-radius: 18px;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(16,54,92,.045), 0 2px 10px rgba(16,54,92,.025);
    }

    .product-strip-item {
        padding: 24px 22px;
        border-right: 1px solid #eef2f7;
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }

        .product-strip-item:last-child {
            border-right: 0;
        }

        .product-strip-item i {
            font-size: 30px;
            color: #ef233c;
            flex-shrink: 0;
        }

        .product-strip-item strong {
            display: block;
            color: #0b1f33;
            font-size: 18px;
            line-height: 1.25;
            font-weight: 850;
            margin-bottom: 6px;
        }

        .product-strip-item span {
            display: block;
            color: #4e5d78;
            font-size: 14px;
            line-height: 1.5;
        }

    /* ===== COMMON SECTIONS ===== */

    .product-section {
        margin: 44px 0;
    }

    .product-section-title {
        color: #0b1f33;
        font-size: 42px;
        line-height: 1.12;
        font-weight: 900;
        letter-spacing: -.03em;
        margin: 0 0 16px;
    }

    .product-section-lead {
        color: #4e5d78;
        font-size: 18px;
        line-height: 1.75;
        max-width: 980px;
        margin-bottom: 28px;
    }

    /* ===== CAPABILITIES ===== */

    .product-capabilities-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 14px;
    }

    .product-capability-card {
        min-height: 166px;
        padding: 22px 20px;
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(16,54,92,.035);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .product-capability-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 40px rgba(16,54,92,.08);
        }

        .product-capability-card i {
            display: block;
            color: #ef233c;
            font-size: 30px;
            margin-bottom: 14px;
        }

        .product-capability-card h3 {
            color: #0b1f33;
            font-size: 17px;
            line-height: 1.25;
            font-weight: 850;
            margin: 0 0 9px;
        }

        .product-capability-card p {
            color: #4e5d78;
            font-size: 13.5px;
            line-height: 1.55;
            margin: 0;
        }

    /* ===== ARCHITECTURE ===== */

    .product-architecture-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        gap: 30px;
        align-items: center;
    }

    .product-architecture-image {
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 16px 42px rgba(16,54,92,.08), 0 4px 12px rgba(16,54,92,.04);
    }

        .product-architecture-image img {
            width: 100%;
            display: block;
        }

    .product-architecture-cards {
        display: grid;
        gap: 16px;
    }

    .product-architecture-card {
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 18px;
        padding: 22px;
        box-shadow: 0 10px 30px rgba(16,54,92,.04);
    }

        .product-architecture-card i {
            color: #ef233c;
            font-size: 30px;
            display: block;
            margin-bottom: 12px;
        }

        .product-architecture-card h3 {
            color: #0b1f33;
            font-size: 21px;
            font-weight: 850;
            margin: 0 0 9px;
        }

        .product-architecture-card p {
            color: #4e5d78;
            line-height: 1.6;
            margin: 0;
        }

    /* ===== DASHBOARD ===== */

    .product-dashboard-grid {
        display: grid;
        grid-template-columns: 360px minmax(0, 1fr);
        gap: 32px;
        align-items: center;
    }

    .product-dashboard-text h2 {
        color: #0b1f33;
        font-size: 34px;
        line-height: 1.18;
        font-weight: 900;
        margin: 0 0 16px;
    }

    .product-dashboard-text p {
        color: #4e5d78;
        font-size: 17px;
        line-height: 1.75;
        margin: 0 0 20px;
    }

    .product-check-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .product-check-list li {
            position: relative;
            color: #4e5d78;
            font-size: 16px;
            line-height: 1.65;
            padding-left: 30px;
            margin-bottom: 12px;
        }

            .product-check-list li::before {
                content: "✓";
                position: absolute;
                left: 0;
                color: #ef233c;
                font-weight: 900;
            }

    .product-dashboard-image {
        background: #071b3a;
        border: 1px solid #142d50;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 18px 46px rgba(7,27,58,.20);
    }

        .product-dashboard-image img {
            width: 100%;
            display: block;
        }

    /* ===== MODULES ===== */

    .product-modules-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    .product-module-card {
        position: relative;
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 20px;
        padding: 26px;
        box-shadow: 0 10px 30px rgba(16,54,92,.04);
        overflow: hidden;
    }

        .product-module-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            height: 4px;
            width: 100%;
            background: #ef233c;
        }

        .product-module-card i {
            color: #ef233c;
            font-size: 34px;
            display: block;
            margin-bottom: 16px;
        }

        .product-module-card h3 {
            color: #0b1f33;
            font-size: 23px;
            line-height: 1.22;
            font-weight: 850;
            margin: 0 0 14px;
        }

        .product-module-card ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .product-module-card li {
            position: relative;
            color: #4e5d78;
            font-size: 15px;
            line-height: 1.55;
            padding-left: 24px;
            margin-bottom: 10px;
        }

            .product-module-card li::before {
                content: "✓";
                color: #ef233c;
                position: absolute;
                left: 0;
                font-weight: 900;
            }

    /* ===== DEPLOYMENT ===== */

    .product-deployment-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    .product-deployment-card {
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 20px;
        padding: 26px;
        box-shadow: 0 10px 30px rgba(16,54,92,.04);
    }

        .product-deployment-card i {
            color: #ef233c;
            font-size: 34px;
            display: block;
            margin-bottom: 14px;
        }

        .product-deployment-card h3 {
            color: #0b1f33;
            font-size: 23px;
            font-weight: 850;
            margin: 0 0 12px;
        }

        .product-deployment-card p {
            color: #4e5d78;
            line-height: 1.65;
            margin: 0;
        }

    /* ===== IMPACT ===== */

    .product-impact-box {
        margin: 40px 0 0;
        padding: 28px 30px;
        background: #ffffff;
        border: 1px solid #eef2f7;
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(16,54,92,.05), 0 2px 10px rgba(16,54,92,.03);
        display: flex;
        align-items: stretch;
        gap: 24px;
    }

    .product-impact-line {
        width: 4px;
        border-radius: 10px;
        background: linear-gradient(180deg, #1598ff 0%, #ef233c 100%);
        flex-shrink: 0;
    }

    .product-impact-content {
        display: flex;
        align-items: flex-start;
        gap: 18px;
    }

        .product-impact-content i {
            font-size: 30px;
            color: #1598ff;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .product-impact-content p {
            margin: 0;
            color: #26384f;
            font-size: 24px;
            line-height: 1.55;
            font-weight: 700;
        }

    .industrial-product-page .meta-bottom {
        margin-top: 38px;
        padding-top: 22px;
        border-top: 1px solid #eef2f7;
    }

    /* ===== RESPONSIVE ===== */

    @@media (max-width: 1200px) {
        .product-hero-section,
        .product-architecture-grid,
        .product-dashboard-grid {
            grid-template-columns: 1fr;
        }

        .product-hero-content {
            padding-right: 0;
        }

        .product-hero-visual {
            height: 520px;
            margin-top: 18px;
        }

        .product-capabilities-grid,
        .product-modules-grid,
        .product-deployment-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .product-meta-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .product-strip {
            grid-template-columns: repeat(2, 1fr);
        }

        .product-strip-item:nth-child(2) {
            border-right: 0;
        }

        .product-strip-item:nth-child(1),
        .product-strip-item:nth-child(2) {
            border-bottom: 1px solid #eef2f7;
        }
    }

    @@media (max-width: 768px) {
        .product-hero-title {
            font-size: 38px;
        }

        .product-section-title {
            font-size: 34px;
        }

        .product-meta-grid,
        .product-strip,
        .product-capabilities-grid,
        .product-modules-grid,
        .product-deployment-grid {
            grid-template-columns: 1fr;
        }

        .product-strip-item {
            border-right: 0 !important;
            border-bottom: 1px solid #eef2f7;
        }

            .product-strip-item:last-child {
                border-bottom: 0;
            }

        .product-hero-visual {
            height: 420px;
        }

        .product-impact-content p {
            font-size: 18px;
        }
    }
</style>

<main class="main">
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Industrial Safety & Violation Control</h1>

            <nav class="breadcrumbs">
                <ol>
                    <li><a href="/">Home</a></li>
                    <li><a href="/home/products">Products</a></li>
                    <li class="current">Industrial Safety & Violation Control</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="container">
        <section class="blog-details section" id="blog-details">
            <div class="container">
                <article class="article">
                    <div class="industrial-product-page">

                        <section class="product-hero-section">
                            <div class="product-hero-content">
                                <div class="product-kicker">Product</div>

                                <h1 class="product-hero-title">
                                    Industrial Safety & Violation Control
                                </h1>

                                <p class="product-hero-subtitle">
                                    AI-powered platform for industrial safety, labor protection, violation detection and operational risk control based on existing CCTV infrastructure.
                                </p>

                                <ul class="product-hero-bullets">
                                    <li>Industrial safety and labor protection control</li>
                                    <li>PPE recognition and violation detection</li>
                                    <li>Emergency detection and equipment monitoring</li>
                                </ul>

                                <div class="product-meta-grid">
                                    <div class="product-meta-card">
                                        <i class="bi bi-shield-check"></i>
                                        <strong>24/7</strong>
                                        <span>Continuous monitoring and incident detection</span>
                                    </div>

                                    <div class="product-meta-card">
                                        <i class="bi bi-cpu"></i>
                                        <strong>100+</strong>
                                        <span>Ready-made AI control scenarios</span>
                                    </div>

                                    <div class="product-meta-card">
                                        <i class="bi bi-bell"></i>
                                        <strong>Real-time</strong>
                                        <span>Alerts, notifications and event archive</span>
                                    </div>

                                    <div class="product-meta-card">
                                        <i class="bi bi-cloud-check"></i>
                                        <strong>Hybrid</strong>
                                        <span>On-Premise, Edge, Cloud deployment</span>
                                    </div>
                                </div>
                            </div>

                            <div class="product-hero-visual">
                                <img src="~/assets/img/products/Industrial safety/industrial-safety-product-hero.png" alt="Industrial safety AI product">
                            </div>
                        </section>

                        <div class="product-strip">
                            <div class="product-strip-item">
                                <i class="bi bi-camera-video"></i>
                                <div>
                                    <strong>Existing CCTV</strong>
                                    <span>Connect current cameras, VMS, NVR, RTSP and ONVIF streams.</span>
                                </div>
                            </div>

                            <div class="product-strip-item">
                                <i class="bi bi-diagram-3"></i>
                                <div>
                                    <strong>Scenario Engine</strong>
                                    <span>Combine AI models, zones, thresholds and business rules.</span>
                                </div>
                            </div>

                            <div class="product-strip-item">
                                <i class="bi bi-bar-chart-line"></i>
                                <div>
                                    <strong>Dashboards & BI</strong>
                                    <span>Incidents, KPI, reports, analytics and event history.</span>
                                </div>
                            </div>

                            <div class="product-strip-item">
                                <i class="bi bi-plug"></i>
                                <div>
                                    <strong>Enterprise Integrations</strong>
                                    <span>ERP, MES, SCADA, BI, Active Directory, API and IIoT.</span>
                                </div>
                            </div>
                        </div>

                        <section class="product-section">
                            <div class="product-section-kicker">Key capabilities</div>

                            <h2 class="product-section-title">
                                Safety Scenarios Included in the Product
                            </h2>

                            <p class="product-section-lead">
                                The product combines real-time violation detection, safety compliance monitoring, event logic, reporting and integration with existing enterprise systems.
                            </p>

                            <div class="product-capabilities-grid">
                                <div class="product-capability-card">
                                    <i class="bi bi-cone-striped"></i>
                                    <h3>PPE Detection</h3>
                                    <p>Helmets, glasses, gloves, masks, safety vests, shields and other PPE items.</p>
                                </div>

                                <div class="product-capability-card">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    <h3>Danger Zones</h3>
                                    <p>Unauthorized access, restricted areas, dynamic hazardous zones and people under suspended load.</p>
                                </div>

                                <div class="product-capability-card">
                                    <i class="bi bi-fire"></i>
                                    <h3>Smoke & Fire</h3>
                                    <p>Early smoke, fire, sparks, flooding and other emergency event detection.</p>
                                </div>

                                <div class="product-capability-card">
                                    <i class="bi bi-phone"></i>
                                    <h3>Phone & Gadgets</h3>
                                    <p>Phone usage and distractions in prohibited industrial work areas.</p>
                                </div>

                                <div class="product-capability-card">
                                    <i class="bi bi-person-slash"></i>
                                    <h3>Smoking Control</h3>
                                    <p>Smoking detection in production, warehouse and restricted areas.</p>
                                </div>

                                <div class="product-capability-card">
                                    <i class="bi bi-person-down"></i>
                                    <h3>Falls & Incidents</h3>
                                    <p>Fall detection, emergency situations and unusual worker posture monitoring.</p>
                                </div>

                                <div class="product-capability-card">
                                    <i class="bi bi-truck"></i>
                                    <h3>Forklift & Vehicle Zones</h3>
                                    <p>Vehicle movement, unsafe proximity and transport route violations.</p>
                                </div>

                                <div class="product-capability-card">
                                    <i class="bi bi-ladder"></i>
                                    <h3>Work at Height</h3>
                                    <p>Safety belts, ladders, scaffolding, railings and elevated work compliance.</p>
                                </div>

                                <div class="product-capability-card">
                                    <i class="bi bi-clipboard-check"></i>
                                    <h3>Regulation Compliance</h3>
                                    <p>Control of procedures, instructions and technological safety rules.</p>
                                </div>

                                <div class="product-capability-card">
                                    <i class="bi bi-gear-wide-connected"></i>
                                    <h3>Equipment Monitoring</h3>
                                    <p>Operating modes, downtime, anomalies, overheating, leaks and process deviations.</p>
                                </div>
                            </div>
                        </section>

