@{ ViewData["Title"] = "STATANLY Multimodal Event Analytics Platform"; }
<header id="header" class="header d-flex align-items-center sticky-top">
    <div class="container-fluid container-xl position-relative d-flex align-items-center">

        <a href="/" class="logo d-flex align-items-center me-auto">
            <img src="~/favicon.png" alt="STATANLY Tech Global">
            <h1 class="sitename">STATANLY</h1>
        </a>

        <nav id="navmenu" class="navmenu">
            <ul>
                <li><a data-i18n="nav.home" href="/">Home</a></li>
                <li><a class="active" href="/factory">AI Factory</a></li>
                <li><a data-i18n="nav.services" href="/services">Services</a></li>
                <li><a data-i18n="nav.products" href="/products">Products</a></li>
                <li><a data-i18n="nav.contacts" href="/home/contacts">Contacts</a></li>

                <!-- Mobile language selector -->
                <li class="mobile-only mobile-lang-block">
                    <div class="mobile-lang-title" data-i18n="common.language">Language</div>

                    <div class="mobile-lang-grid">
                        <button class="mobile-lang-option lang-option" type="button" data-lang="en">
                            <span class="fi fi-gb"></span> English
                        </button>
                        <button class="mobile-lang-option lang-option" type="button" data-lang="pt">
                            <span class="fi fi-pt"></span> Português
                        </button>
                        <button class="mobile-lang-option lang-option" type="button" data-lang="es">
                            <span class="fi fi-es"></span> Español
                        </button>
                        <button class="mobile-lang-option lang-option" type="button" data-lang="it">
                            <span class="fi fi-it"></span> Italiano
                        </button>
                        <button class="mobile-lang-option lang-option" type="button" data-lang="fr">
                            <span class="fi fi-fr"></span> Français
                        </button>
                        <button class="mobile-lang-option lang-option" type="button" data-lang="de">
                            <span class="fi fi-de"></span> Deutsch
                        </button>
                        <button class="mobile-lang-option lang-option" type="button" data-lang="ru">
                            <span class="fi fi-ru"></span> Русский
                        </button>
                    </div>
                </li>

                <!-- Mobile CTA -->
                <li class="mobile-only mobile-cta-block">
                    <a class="mobile-getstarted" href="/#contact" data-i18n="common.getStarted">
                        Get Started
                    </a>
                </li>
            </ul>

            <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
        </nav>

        <!-- Desktop language selector -->
        <div class="language-flags dropdown desktop-lang">
            <button class="lang-current dropdown-toggle" type="button" id="languageDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="fi fi-gb lang-flag"></span>
                <span class="lang-code">EN</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown">
                <li><button class="dropdown-item lang-option" type="button" data-lang="en"><span class="fi fi-gb"></span> English</button></li>
                <li><button class="dropdown-item lang-option" type="button" data-lang="pt"><span class="fi fi-pt"></span> Português</button></li>
                <li><button class="dropdown-item lang-option" type="button" data-lang="es"><span class="fi fi-es"></span> Español</button></li>
                <li><button class="dropdown-item lang-option" type="button" data-lang="it"><span class="fi fi-it"></span> Italiano</button></li>
                <li><button class="dropdown-item lang-option" type="button" data-lang="fr"><span class="fi fi-fr"></span> Français</button></li>
                <li><button class="dropdown-item lang-option" type="button" data-lang="de"><span class="fi fi-de"></span> Deutsch</button></li>
                <li><button class="dropdown-item lang-option" type="button" data-lang="ru"><span class="fi fi-ru"></span> Русский</button></li>
            </ul>
        </div>

        <!-- Desktop CTA -->
        <a class="btn-getstarted desktop-cta" href="/#contact" data-i18n="common.getStarted">Get Started</a>

    </div>
</header>
<style>
    /* =========================================================
       STATANLY PLATFORM PAGE
       Central platform page. Strict site/article template:
       white article card, navy typography, blue accents, red icons.
    ========================================================= */

    .platform-page {
        background: #ffffff;
        color: #172b4d;
    }

        .platform-page * {
            box-sizing: border-box;
        }

    /* ===== HERO ===== */

    .platform-hero-section {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 47%;
        gap: 34px;
        align-items: stretch;
        margin: 0 0 32px;
        padding: 0;
        overflow: hidden;
        background: #ffffff;
    }

    .platform-hero-content {
        position: relative;
        z-index: 3;
        padding-right: 42px;
        padding-top: 8px;
    }

    .platform-kicker,
    .platform-section-kicker {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(21, 152, 255, .08);
        color: #1598ff;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin: 0 0 12px;
    }

    .platform-hero-title {
        color: #0b1f33;
        font-size: 56px;
        line-height: 1.03;
        font-weight: 900;
        letter-spacing: -.045em;
        margin: 0 0 18px;
        max-width: 900px;
    }

    .platform-hero-subtitle {
        color: #4e5d78;
        font-size: 18px;
        line-height: 1.65;
        max-width: 820px;
        margin: 0 0 26px;
    }

    .platform-hero-bullets {
        list-style: none;
        padding: 0;
        margin: 0 0 28px;
        display: grid;
        gap: 13px;
        max-width: 820px;
    }

        .platform-hero-bullets li {
            position: relative;
            padding-left: 32px;
            color: #334155;
            font-size: 17px;
            line-height: 1.55;
            font-weight: 650;
        }

            .platform-hero-bullets li::before {
                content: "✓";
                position: absolute;
                left: 0;
                top: 0;
                color: #ef233c;
                font-weight: 900;
            }

    .platform-meta-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        max-width: 900px;
        margin: 0 0 26px;
    }

    .platform-meta-card {
        min-height: 112px;
        padding: 18px 16px;
        background: #ffffff;
        border: 1px solid #e8edf5;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(16, 54, 92, .045);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .platform-meta-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 34px rgba(16, 54, 92, .07);
        }

        .platform-meta-card i {
            display: block;
            color: #ef233c;
            font-size: 28px;
            margin-bottom: 12px;
        }

        .platform-meta-card strong {
            display: block;
            color: #0b1f33;
            font-size: 21px;
            line-height: 1.15;
            font-weight: 900;
            margin-bottom: 6px;
        }

        .platform-meta-card span {
            display: block;
            color: #4e5d78;
            font-size: 13px;
            line-height: 1.45;
            font-weight: 650;
        }

    .platform-hero-visual {
        position: relative;
        z-index: 1;
        width: 100%;
        height: clamp(620px, 70vw, 860px);
        pointer-events: none;
        overflow: hidden;
        margin-top: -14px;
    }

        .platform-hero-visual::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 2;
            pointer-events: none;
            background: linear-gradient( 90deg, rgba(255,255,255,0.78) 0%, rgba(255,255,255,0.58) 14%, rgba(255,255,255,0.28) 28%, rgba(255,255,255,0.00) 45% );
        }

        /*.platform-hero-visual img {*/
        /*width: calc(100% + 30px);*/
        /*max-width: none;*/
        /*margin-left: -50px;*/
        /*height: calc(100% - 30px);*/
        /*object-fit: cover;
            object-position: center;
            display: block;
            filter: saturate(1.02) contrast(1.02);
        }*/
        .platform-hero-visual img {
            width: 100%;
            height: calc(100% - 7px);
            object-fit: cover;
            object-position: center;
            display: block;
            filter: saturate(1.02) contrast(1.02);
        }

    /* ===== STRIP ===== */

    .platform-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        margin: 22px 0 40px;
        border: 1px solid #eef2f7;
        border-radius: 18px;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(16,54,92,.045), 0 2px 10px rgba(16,54,92,.025);
    }

    .platform-strip-item {
        padding: 24px 22px;
        border-right: 1px solid #eef2f7;
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }

        .platform-strip-item:last-child {
            border-right: 0;
        }

        .platform-strip-item i {
            font-size: 30px;
            color: #ef233c;
            flex-shrink: 0;
        }

        .platform-strip-item strong {
            display: block;
            color: #0b1f33;
            font-size: 18px;
            line-height: 1.25;
            font-weight: 850;
            margin-bottom: 6px;
        }

        .platform-strip-item span {
            display: block;
            color: #4e5d78;
            font-size: 14px;
            line-height: 1.5;
        }

    /* ===== COMMON SECTIONS ===== */

    .platform-section {
        margin: 44px 0;
    }

    .platform-section-title {
        color: #0b1f33;
        font-size: 42px;
        line-height: 1.12;
        font-weight: 900;
        letter-spacing: -.03em;
        margin: 0 0 16px;
    }

    .platform-section-lead {
        color: #4e5d78;
        font-size: 18px;
        line-height: 1.75;
        max-width: 980px;
        margin-bottom: 28px;
    }

    /* ===== PIPELINE ===== */

    .platform-pipeline-image,
    .platform-architecture-image {
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 16px 42px rgba(16,54,92,.08), 0 4px 12px rgba(16,54,92,.04);
    }

        .platform-pipeline-image img,
        .platform-architecture-image img {
            width: 100%;
            display: block;
        }

    .platform-pipeline-note {
        margin-top: 24px;
        padding: 28px 30px;
        background: #ffffff;
        border: 1px solid #eef2f7;
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(16,54,92,.05), 0 2px 10px rgba(16,54,92,.03);
        display: flex;
        align-items: stretch;
        gap: 24px;
    }

    .platform-pipeline-line {
        width: 4px;
        border-radius: 10px;
        background: linear-gradient(180deg, #1598ff 0%, #ef233c 100%);
        flex-shrink: 0;
    }

    .platform-pipeline-content {
        display: flex;
        align-items: flex-start;
        gap: 18px;
    }

        .platform-pipeline-content i {
            font-size: 30px;
            color: #1598ff;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .platform-pipeline-content p {
            margin: 0;
            color: #26384f;
            font-size: 24px;
            line-height: 1.55;
            font-weight: 700;
        }

    /* ===== COMPONENTS ===== */

    .platform-components-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .platform-component-card {
        position: relative;
        min-height: 230px;
        padding: 28px;
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(16,54,92,.04);
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .platform-component-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 40px rgba(16,54,92,.08);
        }

        .platform-component-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            height: 4px;
            width: 100%;
            background: #ef233c;
        }

        .platform-component-card i {
            color: #ef233c;
            font-size: 34px;
            display: block;
            margin-bottom: 16px;
        }

        .platform-component-card h3 {
            color: #0b1f33;
            font-size: 23px;
            line-height: 1.22;
            font-weight: 850;
            margin: 0 0 13px;
        }

        .platform-component-card p {
            color: #4e5d78;
            font-size: 15.5px;
            line-height: 1.65;
            margin: 0;
        }

    /* ===== AI FACTORY ===== */

    .platform-factory-grid {
        display: grid;
        grid-template-columns: 360px minmax(0, 1fr);
        gap: 30px;
        align-items: stretch;
    }

    .platform-factory-main {
        background: #071b3a;
        color: #ffffff;
        border-radius: 22px;
        padding: 32px;
        box-shadow: 0 18px 46px rgba(7,27,58,.18);
    }

        .platform-factory-main i {
            color: #1598ff;
            font-size: 42px;
            display: block;
            margin-bottom: 18px;
        }

        .platform-factory-main h3 {
            font-size: 30px;
            line-height: 1.2;
            font-weight: 900;
            margin: 0 0 14px;
        }

        .platform-factory-main p {
            color: rgba(255,255,255,.78);
            font-size: 17px;
            line-height: 1.7;
            margin: 0;
        }

    .platform-factory-steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .platform-factory-step {
        padding: 22px;
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(16,54,92,.04);
    }

        .platform-factory-step span {
            display: inline-flex;
            width: 34px;
            height: 34px;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            color: #ffffff;
            background: #ef233c;
            font-weight: 900;
            margin-bottom: 14px;
        }

        .platform-factory-step h4 {
            color: #0b1f33;
            font-size: 19px;
            line-height: 1.25;
            font-weight: 850;
            margin: 0 0 9px;
        }

        .platform-factory-step p {
            color: #4e5d78;
            font-size: 14.5px;
            line-height: 1.6;
            margin: 0;
        }

    /* ===== USE CASES ===== */

    .platform-usecase-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 14px;
    }

    .platform-usecase-card {
        position: relative;
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 18px;
        padding: 22px 20px;
        box-shadow: 0 10px 30px rgba(16,54,92,.04);
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .platform-usecase-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 40px rgba(16,54,92,.08);
        }

        .platform-usecase-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            height: 4px;
            width: 100%;
            background: #ef233c;
        }

        .platform-usecase-card i {
            color: #ef233c;
            font-size: 30px;
            display: block;
            margin-bottom: 14px;
        }

        .platform-usecase-card h3 {
            color: #0b1f33;
            font-size: 17px;
            line-height: 1.25;
            font-weight: 850;
            margin: 0 0 10px;
        }

        .platform-usecase-card p {
            color: #4e5d78;
            font-size: 13.5px;
            line-height: 1.55;
            margin: 0;
        }

    /* ===== DEPLOYMENT ===== */

    .platform-deployment-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    .platform-deployment-card {
        background: #ffffff;
        border: 1px solid #e7edf5;
        border-radius: 20px;
        padding: 26px;
        box-shadow: 0 10px 30px rgba(16,54,92,.04);
    }

        .platform-deployment-card i {
            color: #ef233c;
            font-size: 34px;
            display: block;
            margin-bottom: 14px;
        }

        .platform-deployment-card h3 {
            color: #0b1f33;
            font-size: 23px;
            font-weight: 850;
            margin: 0 0 12px;
        }

        .platform-deployment-card p {
            color: #4e5d78;
            line-height: 1.65;
            margin: 0;
        }

    /* ===== IMPACT ===== */

    .platform-impact-box {
        margin: 40px 0 0;
        padding: 28px 30px;
        background: #ffffff;
        border: 1px solid #eef2f7;
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(16,54,92,.05), 0 2px 10px rgba(16,54,92,.03);
        display: flex;
        align-items: stretch;
        gap: 24px;
    }

    .platform-impact-line {
        width: 4px;
        border-radius: 10px;
        background: linear-gradient(180deg, #1598ff 0%, #ef233c 100%);
        flex-shrink: 0;
    }

    .platform-impact-content {
        display: flex;
        align-items: flex-start;
        gap: 18px;
    }

        .platform-impact-content i {
            font-size: 30px;
            color: #1598ff;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .platform-impact-content p {
            margin: 0;
            color: #26384f;
            font-size: 24px;
            line-height: 1.55;
            font-weight: 700;
        }

    .platform-page .meta-bottom {
        margin-top: 38px;
        padding-top: 22px;
        border-top: 1px solid #eef2f7;
    }

    /* ===== RESPONSIVE ===== */

    @@media (max-width: 1200px) {
        .platform-hero-section,
        .platform-factory-grid {
            grid-template-columns: 1fr;
        }

        .platform-hero-content {
            padding-right: 0;
        }

        .platform-hero-visual {
            height: 520px;
            margin-top: 18px;
        }

        .platform-meta-grid,
        .platform-strip,
        .platform-deployment-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .platform-components-grid,
        .platform-factory-steps {
            grid-template-columns: repeat(2, 1fr);
        }

        .platform-usecase-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .platform-strip-item:nth-child(2) {
            border-right: 0;
        }

        .platform-strip-item:nth-child(1),
        .platform-strip-item:nth-child(2) {
            border-bottom: 1px solid #eef2f7;
        }
    }

    @@media (max-width: 768px) {
        .platform-hero-title {
            font-size: 38px;
        }

        .platform-section-title {
            font-size: 34px;
        }

        .platform-meta-grid,
        .platform-strip,
        .platform-components-grid,
        .platform-factory-steps,
        .platform-usecase-grid,
        .platform-deployment-grid {
            grid-template-columns: 1fr;
        }

        .platform-strip-item {
            border-right: 0 !important;
            border-bottom: 1px solid #eef2f7;
        }

            .platform-strip-item:last-child {
                border-bottom: 0;
            }

        .platform-hero-visual {
            height: 420px;
        }

        .platform-pipeline-content p,
        .platform-impact-content p {
            font-size: 18px;
        }
    }
</style>

<main class="main">
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0" data-i18n="platform.pageTitle">STATANLY Multimodal Event Analytics Platform</h1>

            <nav class="breadcrumbs">
                <ol>
                    <li><a href="/" data-i18n="nav.home">Home</a></li>
                    <li class="current" data-i18n="nav.platform">Platform</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="container content-page-shell">
        <section class="blog-details section content-page-section" id="blog-details">
            <div class="container content-page-inner">
                <article class="article content-page-article">
                    <div class="platform-page">

                        <section class="platform-hero-section">
                            <div class="platform-hero-content">
                                <div class="platform-kicker" data-i18n="platform.hero.kicker">AI Operating System</div>

                                <h1 class="platform-hero-title" data-i18n="platform.hero.title">Multimodal Event Analytics Platform</h1>

                                <p class="platform-hero-subtitle" data-i18n="platform.hero.subtitle">A unified enterprise AI platform for creating, training, deploying and managing event analytics scenarios across video, audio, sensors, VMS and enterprise systems.</p>

                                <ul class="platform-hero-bullets">
                                    <li data-i18n="platform.hero.bullet1">Turns isolated CV modules into a single intelligent event analytics layer</li>
                                    <li data-i18n="platform.hero.bullet2">Combines Computer Vision, Speech Analytics, LLM, VLM, Generative AI and low-code scenario orchestration</li>
                                    <li data-i18n="platform.hero.bullet3">Enables users to create new AI scenarios from natural-language task descriptions</li>
                                </ul>

                                <div class="platform-meta-grid">
                                    <div class="platform-meta-card">
                                        <i class="bi bi-camera-video"></i>
                                        <strong data-i18n="platform.hero.card.videoAudio.title">Video + Audio</strong>
                                        <span data-i18n="platform.hero.card.videoAudio.text">Multimodal analytics for events, violations and operations</span>
                                    </div>

                                    <div class="platform-meta-card">
                                        <i class="bi bi-stars"></i>
                                        <strong data-i18n="platform.hero.card.genaiVlm.title">GenAI + VLM</strong>
                                        <span data-i18n="platform.hero.card.genaiVlm.text">Natural-language scenario creation and dataset preparation</span>
                                    </div>

                                    <div class="platform-meta-card">
                                        <i class="bi bi-diagram-3"></i>
                                        <strong data-i18n="platform.common.scenarioEngine">Scenario Engine</strong>
                                        <span data-i18n="platform.hero.card.scenario.text">Low-code rules, workflows and operational automation</span>
                                    </div>

                                    <div class="platform-meta-card">
                                        <i class="bi bi-cloud-check"></i>
                                        <strong data-i18n="platform.hero.card.cloudOnPrem.title">Cloud / OnPrem</strong>
                                        <span data-i18n="platform.hero.card.cloudOnPrem.text">Hybrid architecture for enterprise deployment</span>
                                    </div>
                                </div>
                            </div>

                            <div class="platform-hero-visual">
                                <img src="~/assets/img/platform/platform-hero-core.png" alt="STATANLY multimodal event analytics platform core">
                            </div>
                        </section>

                        <div class="platform-strip">
                            <div class="platform-strip-item">
                                <i class="bi bi-boxes"></i>
                                <div>
                                    <strong data-i18n="platform.strip.models.title">AI Models Library</strong>
                                    <span data-i18n="platform.strip.models.text">Ready-made modules for safety, behavior, operations, quality and industry scenarios.</span>
                                </div>
                            </div>

                            <div class="platform-strip-item">
                                <i class="bi bi-magic"></i>
                                <div>
                                    <strong data-i18n="platform.common.aiFactory">AI Factory</strong>
                                    <span data-i18n="platform.strip.factory.text">Data collection, annotation, synthetic datasets, model training and registry.</span>
                                </div>
                            </div>

                            <div class="platform-strip-item">
                                <i class="bi bi-kanban"></i>
                                <div>
                                    <strong data-i18n="platform.common.scenarioEngine">Scenario Engine</strong>
                                    <span data-i18n="platform.strip.scenario.text">Create complex monitoring and automation logic from reusable AI modules.</span>
                                </div>
                            </div>

                            <div class="platform-strip-item">
                                <i class="bi bi-plug"></i>
                                <div>
                                    <strong data-i18n="platform.strip.integration.title">VMS / Enterprise Integration</strong>
                                    <span data-i18n="platform.strip.integration.text">Connect cameras, VMS, SCADA, ERP, access control, BI and APIs.</span>
