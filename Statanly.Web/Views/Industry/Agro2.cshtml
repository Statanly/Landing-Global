                <div class="col-lg-4">
                    <div class="portfolio-details-slider" style="margin-top: 10px">
                        <div class="align-items-center">
                            <div class="swiper-slide">
                                <img src="~/assets/img/Industry/Agro/8.jpg" alt="">
                            </div>
                        </div>
                    </div>
                </div>
