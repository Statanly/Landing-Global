@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    Layout = "/Views/Shared/_SolutionsLayout.cshtml";
}
<main id="main">
    <!-- ======= Breadcrumbs ======= -->
    <section id="breadcrumbs" class="breadcrumbs">
        <div class="container">
            <ol>

                <li><a href="/home/services">Все сервисы</a></li>
                <li>Агропромышленность</li>
                <li><a href="/service/restaurants">Рестораны</a></li>
                <li><a href="/service/banks">Банки</a></li>
                <li><a href="/service/pvz">ПВЗ</a></li>
                <li><a href="/service/warehouses">Склады</a></li>
                <li><a href="/service/Parking ">Парковки</a></li>
                <li><a href="/service/Business ">Бизнес-центры</a></li>
                <li><a href="/service/shops">Магазины</a></li>
                <li><a href="/service/beauty ">Салоны красоты</a></li>
                <li><a href="/service/industry">Производство</a></li>
                <li><a href="/service/hospitals">Медицинские учреждения</a></li>
            </ol>
            <h2>Неинвазивное взвешивание</h2>
        </div>
    </section><!-- End Breadcrumbs -->

    <section id="cta" class="cta">
        <div class="container">

            <div class="row" data-aos="zoom-in">
                <div class="col-lg-9 text-center text-lg-start">
                    <h3>Измерение веса животного без непосредственного контакта с ним</h3>
                    <p>Повышение эффективности откорма свиней</p>
                </div>
                <div class="col-lg-3 cta-btn-container text-center">
                    <a class="cta-btn align-middle" href="/home/contact">Оставить заявку</a>
                </div>
            </div>
        </div>
    </section><!-- End Cta Section -->
    <!-- ======= Portfolio Details Section ======= -->
    <section id="portfolio-details" class="portfolio-details">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4">
                    <div class="portfolio-details-slider">
                        <div class="align-items-center">
                            <div class="swiper-slide">
                                <img src="~/assets/img/Services/Agro/1.jpg" alt="">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">

                    <div class="portfolio-description">
                        <h2>Система компьютерного зрения</h2>
                        <p>
                            Включает в себя видеокамеры для сбора данных об особях, находящихся в станке, анализатор видеоданных и программное обеспечение для обработки информации.
                        </p>
                        <p>
                            Технология позволяет использовать простые и недорогие видеокамеры и обеспечивать ежедневный контроль прироста каждого животного без стрессов и без участия человека.
                        </p>
                    </div>
                </div>
            </div>
            <div class="row gy-4">
                <div class="col-lg-8">
                    <div class="portfolio-description">
                        <h2>Отслеживание каждого животного в группе</h2>
                        <p>
                            Камеры непрерывно отслеживают движения и перемещения, формируя хронометраж поведения каждой особи.
                        </p>
                        <p>
                            Это позволяет на ранних стадиях выявлять заболевших и ослабленных животных и вести пристальное наблюдение за их поведением с целью определения причин их нездоровья.
                        </p>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="portfolio-details-slider">
                        <div class="align-items-center">
                            <div class="swiper-slide">
                                <img src="~/assets/img/Services/Agro/2.jpg" alt="">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row gy-4">
                <div class="col-lg-4">
                    <div class="portfolio-details-slider">
                        <div class="align-items-center">
                            <div class="swiper-slide">
                                <img src="~/assets/img/Services/Agro/3.jpg" alt="">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">

                    <div class="portfolio-description">
                        <h2>Ежедневный контроль прироста каждого животного без стрессов и без участия человека</h2>
                        <p>
                            Опытный свиновод способен оценить массу свиньи на глаз с точностью +/- 5 кг. Специально обученный компьютер делает это с минимальной погрешность 1-3%.
                        </p>
                        <p>
                            Изменение размеров свиньи за период является более релевантным показателем прироста, нежели изменение массы. Вес свиньи в зависимости от приема воды и пищи может отличаться на 5% в течение суток.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section><!-- End Portfolio Details Section -->
</main><!-- End #main -->
