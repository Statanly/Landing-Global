    <section id="cta" class="cta">
        <div class="container">

            <div class="row" data-aos="zoom-in">
                <div class="col-lg-9 text-center text-lg-start">
                    <h3>Оптимизация животноводческого производства</h3>
                    <p>Повышение эффективности производства</p>
                </div>
                <div class="col-lg-3 cta-btn-container text-center">
                    <a class="cta-btn align-middle" href="/home/contact">Оставить заявку</a>
                </div>
            </div>
        </div>
    </section><!-- End Cta Section -->
    <!-- ======= Portfolio Details Section ======= -->
    <section id="portfolio-details" class="portfolio-details blog about">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-3">
                    <div class="portfolio-details-slider">
                        <div class="align-items-center">
                            <div class="swiper-slide">
                                <a href="/industry/pigs"><img src="~/assets/img/Industry/Agro/pigs.jpg" alt=""></a> 
                            </div>
                        </div>
                    </div>
                    <article class="entry">
                        <div class="entry-content">
                            <div class="read-more">
                                <a href="/industry/pigs">Свиноводство</a>
                            </div>
                        </div>                  
                    </article>
                </div>
                <div class="col-lg-6">
                    <div class="portfolio-description" style="margin-top:  -30px">
                        <strong>Система</strong> представляет полноценный программно-аппаратный комплекс для сбора и анализа данных об особях и программное обеспечение для обработки информации. <u>Основные решаемые задачи:</u>
                        <div class=" row">
                            <div class="col-md-6">
                                <ul>
                                    <li>
                                        Подсчёт количества объектов на конвейере и потоке
                                    </li>
                                    <li>
                                        Неинвазивное взвешивание - оценка массы животного на основании его размера
                                    </li>
                                    <li>
                                        Определения степени упитанности крупного рогатого скота
                                    </li>
                                    <li>
                                        Классификация животных туш
                                    </li>
                                    <li>
                                        Отслеживание рождения и кормления молодых животных
                                    </li>               
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <ul>
                                    <li>
                                        Автоматического обнаружение и классификация дефектов на тушке.
                                    </li>
                                    <li>
                                        Автоматизация проверки молока, цветности, сахара и т.д.
                                    </li>
                                    <li>
                                        Видеоаналитика эффективности работы персонала
                                    </li>
                                    <li>
                                        Опасное сближение. Промышленная безопасность. Контроль использования СИЗ
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="col-lg-3">
                    <div class="portfolio-details-slider">
                        <div class="align-items-center">
                            <div class="swiper-slide">
                                <a href="/industry/cows"><img src="~/assets/img/Industry/Agro/cows.jpg" alt=""></a>                                
                            </div>
                        </div>
                        <article class="entry">
                            <div class="entry-content">
                                <div class="read-more">
                                    <a href="/industry/cows">Скотоводство</a>
                                </div>
                            </div>
                        </article>
                    </div>
                </div>
