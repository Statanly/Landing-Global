@model Statanly.Web.Models.NewsletterViewModel

@{
    ViewData["Title"] = "Newsletter";
    var mes = (string)ViewBag.Message;
}

<!-- ======= Header ======= -->
<header id="header" class="fixed-top d-flex align-items-center header-inner-pages">
    <div class="container d-flex align-items-center justify-content-between">
        <a href="/"><img class="logo" style="height: 43px; width: 160px" src="~/assets/img/logo.png"></a>
        @*<h1 class="logo"><a href="index.html">Anyar</a></h1>*@
        <!-- Uncomment below if you prefer to use an image logo -->
        <!-- <a href=index.html" class="logo"><img src="assets/img/logo.png" alt="" class="img-fluid"></a>-->

        <nav id="navbar" class="navbar">
            <ul>
                <li><a class="nav-link scrollto" href="/">Main</a></li>
                <li><a class="nav-link scrollto" href="/home/solution">Solutions</a></li>
                <li><a class="nav-link scrollto" href="/home/company">Company</a></li>
                <li><a class="nav-link scrollto" href="/home/research">Research</a></li>
                <li><a class="nav-link scrollto "href="/home/contact">Contacts</a></li>
                <li class="dropdown">
                    <a href="#"><span>En</span> <i class="bi bi-chevron-down"></i></a>
                    <ul>
                        <li><a href="/home/setLanguage?culture=ru&returnUrl=@Context.Request.Path">Ru</a></li>
                        <li><a href="/home/setLanguage?culture=en&returnUrl=@Context.Request.Path">En</a></li>
                    </ul>
                </li>
            </ul>
            <i class="bi bi-list mobile-nav-toggle"></i>
        </nav><!-- .navbar -->

    </div>
</header><!-- End Header -->

<main id="main">

    <div class="container" style="margin-top: 150px">
        <article class="col-sm-9 maincontent">
            <header class="page-header">
                <h1 class="page-title">Рассылка</h1>
            </header>

            <p>
                @mes
            </p>
            <br>
            <form method="post" action="/message/Newsletter">
                <div class="row">
                    <div class="col-sm-6">
                        <input class="form-control" type="text" name="Subject" placeholder="Subject">
                    </div>
                    <div class="col-sm-6">
                        <textarea placeholder="Emails" class="form-control" name="Emails" rows="9"></textarea>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <input class="form-control" type="text" name="FromEmail" placeholder="От кого">
                    </div>
                    <div class="col-sm-6">
                        <input class="form-control" type="password" name="Password" placeholder="Password">
                    </div>
                </div>
                <br>
                <div class="row">
                    <div class="col-sm-12">
                        <textarea placeholder="Text" class="form-control" name="text" rows="9"></textarea>
                    </div>
                </div>
                <br>

                <div class="row">
                    <div class="col-sm-6 text-right">
                        <input class="btn btn-info" type="submit" value="Отправить">
                    </div>
                </div>
            </form>

        </article>
    </div>

 </main>